extends CharacterBody2D
#extends Node2D
signal health_changed(new_health)
signal stamina_changed(value: float)

@export var max_stamina: float = 100.0
@export var sprint_stamina_per_second: float = 20.0
@export var melee_stamina_cost: float = 18.0
@export_group("Heavy axe attack")
@export_range(0.05, 0.3, 0.01) var melee_hold_threshold: float = 0.18
@export_range(0.3, 1.5, 0.05) var heavy_charge_time: float = 0.4
@export var heavy_stamina_cost: float = 30.0
@export var heavy_hold_stamina_per_second: float = 6.0
@export var test_unlimited_melee_stamina: bool = true
@export_group("Melee movement")
@export var melee_lunge_speed: float = 45.0
@export var heavy_melee_lunge_speed: float = 150.0
@export var melee_wall_recoil_speed: float = 75.0
@export var melee_wall_recovery_time: float = 0.24
@export var heavy_damage_multiplier: float = 2.5
@export_range(1.0, 3.0, 0.05) var heavy_radius_multiplier: float = 1.75
@export var heavy_reach_bonus: float = 10.0
@export_group("")
@export var stamina_regen_per_second: float = 25.0
@export var stamina_regen_delay: float = 1.0
@export var sprint_restart_stamina: float = 25.0
var stamina: float = 100.0
var stamina_rest_timer: float = 0.0
var sprint_exhausted: bool = false

func _spend_stamina(amount: float) -> void:
	stamina = maxf(0.0, stamina - amount)
	stamina_rest_timer = stamina_regen_delay
	if stamina <= 0.0:
		sprint_exhausted = true
	stamina_changed.emit(stamina)

func _melee_has_stamina(cost: float) -> bool:
	return test_unlimited_melee_stamina or stamina >= cost

func _can_sprint() -> bool:
	return stamina > 0.0 and not sprint_exhausted

func _update_stamina(delta: float) -> void:
	if state == ON_FLOOR and Input.is_action_pressed("run") and Input.get_axis("left", "right") != 0.0 and absf(velocity.x) > 1.0 and _can_sprint():
		_spend_stamina(sprint_stamina_per_second * delta)
		if not _can_sprint():
			RUN_SPEED = 1
		return
	if state in [ATTACK, ATTACK2, ATTACK3, MELEE_CHARGE]:
		stamina_rest_timer = stamina_regen_delay
		return
	var recovery_delta := maxf(0.0, delta - stamina_rest_timer)
	stamina_rest_timer = maxf(0.0, stamina_rest_timer - delta)
	if recovery_delta > 0.0 and stamina < max_stamina:
		stamina = minf(max_stamina, stamina + stamina_regen_per_second * recovery_delta)
		stamina_changed.emit(stamina)
	if stamina >= minf(sprint_restart_stamina, max_stamina):
		sprint_exhausted = false



