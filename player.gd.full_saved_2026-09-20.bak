	IN_WATER,
	MELEE_CHARGE,
	ON_CLIMB_BOX # переносим ящик
}
var state: int = IN_AIR

func _ready() -> void:
	# После разворота скорость становилась 1.8, поэтому стартовая ходьба
	# до первого разворота выглядела замедленной.
	anim.speed_scale = DEFAULT_ANIMATION_SPEED_SCALE
	player_camera_base_position = player_camera.position
	if is_instance_valid(startPosition):
		global_position = startPosition.global_position
	
	health = max_health
	stamina = max_stamina
	_rng.randomize()
	_setup_audio()
	Signals.connect('enemy_attack', Callable(self, '_on_damage_received'))
	animPlayer.animation_finished.connect(_on_melee_animation_finished)
	anim.animation_finished.connect(_on_sprite_animation_finished)
	$AttackDirection/DamageBox/HitBox.body_entered.connect(_on_melee_body_entered)
	melee_normal_shape = melee_hitbox.shape.duplicate()
	melee_hitbox.shape = melee_normal_shape
	melee_hitbox_position = melee_hitbox.position
	melee_heavy_shape = CircleShape2D.new()
	melee_heavy_shape.radius = (melee_normal_shape as CircleShape2D).radius * heavy_radius_multiplier
	# Подготовка к прыжку должна проиграться один раз и остаться на последнем кадре.
	if anim.sprite_frames.has_animation(&"wall_hands_forward"):
		anim.sprite_frames.set_animation_loop(&"wall_hands_forward", false)
	if anim.sprite_frames.has_animation(&"wall_hands_contact"):
		anim.sprite_frames.set_animation_loop(&"wall_hands_contact", true)
	if anim.sprite_frames.has_animation(&"wall_contact_start"):
		anim.sprite_frames.set_animation_loop(&"wall_contact_start", false)
	if anim.sprite_frames.has_animation(&"wall_contact_idle"):
		anim.sprite_frames.set_animation_loop(&"wall_contact_idle", true)
	if anim.sprite_frames.has_animation(&"climb_box_grab"):
		anim.sprite_frames.set_animation_loop(&"climb_box_grab", false)
	if anim.sprite_frames.has_animation(&"new_ledge_climbing"):
		anim.sprite_frames.set_animation_loop(&"new_ledge_climbing", false)
	if anim.sprite_frames.has_animation(&"new_climbung_ledge_up"):
		anim.sprite_frames.set_animation_loop(&"new_climbung_ledge_up", false)
	if anim.sprite_frames.has_animation(&"climb_box_up"):
		anim.sprite_frames.set_animation_loop(&"climb_box_up", false)
	if anim.sprite_frames.has_animation(&"ladder_side_blocked"):
		anim.sprite_frames.set_animation_loop(&"ladder_side_blocked", true)
	if anim.sprite_frames.has_animation(&"run_stop"):
		anim.sprite_frames.set_animation_loop(&"run_stop", false)
	if anim.sprite_frames.has_animation(&"very_sTRONG_FALL"):
		anim.sprite_frames.set_animation_loop(&"very_sTRONG_FALL", false)
	if anim.sprite_frames.has_animation(&"ledge_grab_down"):
		anim.sprite_frames.set_animation_loop(&"ledge_grab_down", false)
	_ensure_bar_animation(&"look_up", &"idle", false)
	_ensure_bar_animation(&"bar_hang", &"pipe_swing", true)
	_ensure_bar_animation(&"bar_move", &"walking", true)
	_ensure_bar_animation(&"bar_prepare_jump_left", &"wall_hands_forward", false)
	_ensure_bar_animation(&"bar_prepare_jump_right", &"wall_hands_forward", false)
	_ensure_bar_animation(&"ladder_prepare_jump", &"ladder_climbing", false)
	_ensure_bar_animation(&"ladder_prepare_jump_idle", &"ladder_climbing_idle", true)
	_ensure_bar_animation(&"ladder_prepare_jump_return", &"ladder_prepare_jump", false)

func _ensure_bar_animation(animation_name: StringName, fallback_name: StringName, loop_animation: bool) -> void:
	if anim.sprite_frames.has_animation(animation_name):
		anim.sprite_frames.set_animation_loop(animation_name, loop_animation)
		return
	if not anim.sprite_frames.has_animation(fallback_name):
		return
	anim.sprite_frames.add_animation(animation_name)
	var frame_count: int = anim.sprite_frames.get_frame_count(fallback_name)
	for frame_index in range(frame_count):
		anim.sprite_frames.add_frame(animation_name, anim.sprite_frames.get_frame_texture(fallback_name, frame_index), anim.sprite_frames.get_frame_duration(fallback_name, frame_index))
	anim.sprite_frames.set_animation_speed(animation_name, anim.sprite_frames.get_animation_speed(fallback_name))
	anim.sprite_frames.set_animation_loop(animation_name, loop_animation)

func _sync_legs() -> void:
	if not is_instance_valid(legs_anim):
		return
	var legs_animation: StringName = anim.animation
	if not legs_anim.sprite_frames.has_animation(legs_animation):
		legs_animation = "idle"
	if legs_anim.sprite_frames.has_animation(legs_animation):
		legs_anim.animation = legs_animation
		var frame_count := legs_anim.sprite_frames.get_frame_count(legs_animation)
		if frame_count > 0:
			legs_anim.frame = mini(anim.frame, frame_count - 1)
	legs_anim.speed_scale = anim.speed_scale
	legs_anim.flip_h = anim.flip_h
	# Не накладываем отдельные ноги поверх полнофигурных анимаций
	# (например, run_stop), иначе на смене кадра появляется мигание.
	legs_anim.visible = $AimRig.visible and not anim.visible

func _play_idle_sprite() -> void:
	# Idle управляется самим AnimatedSprite2D, чтобы AnimationPlayer не
	# перезаписывал кадры покоя каждый физический кадр.
	if run_stop_active and anim.animation == &"run_stop" and anim.is_playing():
		return
	if wall_contact_active or is_on_wall() or raycast_hands:
		_play_wall_contact_animation()
		return
	if animPlayer.is_playing():
		animPlayer.stop()
	if anim.sprite_frames.has_animation(&"idle") and anim.animation != &"idle":
		anim.play(&"idle")
	elif anim.sprite_frames.has_animation(&"idle") and not anim.is_playing():
		anim.play(&"idle")

func _on_sprite_animation_finished() -> void:
	# Одноразовый run_stop должен завершаться только по своему сигналу,
	# а не по промежуточной проверке is_playing() в физическом кадре.
	if anim.animation == &"run_stop" and run_stop_active:
		run_stop_active = false
	elif anim.animation == &"wall_contact_start" and wall_contact_active:
		# После подготовительной анимации сразу переходим в постоянный упор.
		wall_contact_starting = false
		anim.play(&"wall_contact_idle")

func _play_wall_contact_animation() -> void:
	if animPlayer.is_playing():
		animPlayer.stop()
	if anim.sprite_frames.has_animation(&"wall_contact_start") and anim.sprite_frames.has_animation(&"wall_contact_idle"):
		# При первом кадре упора запоминаем переход, чтобы не перезапускать
		# стартовую анимацию каждый физический кадр.
		if not wall_contact_starting and anim.animation != &"wall_contact_start" and anim.animation != &"wall_contact_idle":
			wall_contact_starting = true
		if wall_contact_starting:
			if anim.animation == &"wall_contact_start" and anim.is_playing():
				return
			if anim.animation == &"wall_contact_start" and not anim.is_playing():
				wall_contact_starting = false
			elif anim.animation == &"wall_contact_idle" and anim.is_playing():
				wall_contact_starting = false
				return
			else:
				anim.play(&"wall_contact_start")
				return
		if anim.animation != &"wall_contact_idle" or not anim.is_playing():
			anim.play(&"wall_contact_idle")
	elif anim.sprite_frames.has_animation(&"wall_hands_contact"):
		if anim.animation != &"wall_hands_contact" or not anim.is_playing():
			anim.play(&"wall_hands_contact")

func _play_ladder_climbing_sprite() -> void:
	# Вертикальное движение по лестнице проигрывается напрямую через
	# AnimatedSprite2D, без ручного трека кадров в AnimationPlayer.
	if not anim.sprite_frames.has_animation(&"ladder_climbing"):
		return
	if animPlayer.is_playing():
		animPlayer.stop()
	if anim.animation != &"ladder_climbing" or not anim.is_playing():
		anim.play(&"ladder_climbing")

func _play_ladder_climbing_idle_sprite() -> void:
	if not anim.sprite_frames.has_animation(&"ladder_climbing_idle"):
		return
	if animPlayer.is_playing():
		animPlayer.stop()
	if anim.animation != &"ladder_climbing_idle" or not anim.is_playing():
		anim.play(&"ladder_climbing_idle")

func _start_ladder_side_return() -> void:
	if ladder_side_return_active:
		return
	ladder_side_return_active = true
	animPlayer.stop()
	anim.play(&"ladder_prepare_jump_return")
	await anim.animation_finished
	if state == ON_LADDER and not Input.is_action_pressed("left") and not Input.is_action_pressed("right"):
		_play_ladder_climbing_idle_sprite()
	ladder_side_return_active = false

func play_box_animation(mode: StringName) -> void:
	var animation_name: StringName = &"hero_push_idle"
	if mode == &"push":
		animation_name = &"push"
	elif mode == &"pull":
		animation_name = &"pull"
	if not anim.sprite_frames.has_animation(animation_name):
		return
	if animPlayer.is_playing():
		animPlayer.stop()
	if anim.animation != animation_name or not anim.is_playing():
		anim.play(animation_name)

func begin_climb_box(box: Node2D, carry_side: float) -> void:
	if active_climb_box != null:
		return
	active_climb_box = box
	var grab_y := global_position.y
	climb_box_look_left = not dir_look
	# Захватываем высоту до запуска стартовой анимации. Пока она играет,
	# игрок не должен проседать: при первом движении ящика его Y уже
	# принудительно синхронизируется, из-за чего просадка была незаметна.
	climb_box_saved_collision_layer = collision_layer
	climb_box_saved_collision_mask = collision_mask
	collision_layer = 0
	collision_mask = 0
	velocity = Vector2.ZERO
	state = ON_CLIMB_BOX
	animPlayer.stop()
	anim.flip_h = climb_box_look_left
	if anim.sprite_frames.has_animation(&"climb_box_grab"):
		anim.play(&"climb_box_grab")
	else:
		play_box_animation(&"hero_push_idle")
	var grab_tween := get_tree().create_tween()
	grab_tween.tween_property(self, "global_position:x", box.global_position.x, 0.35).set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_OUT)
	await grab_tween.finished
	global_position.y = grab_y
	play_box_animation(&"hero_push_idle")

func set_climb_box_direction(direction: float) -> void:
	if state != ON_CLIMB_BOX or is_zero_approx(direction):
		return
	if climb_box_look_left:
		anim.flip_h = true
		play_box_animation(&"push" if direction < 0.0 else &"pull")
	else:
		anim.flip_h = false
		play_box_animation(&"pull" if direction < 0.0 else &"push")

func release_climb_box() -> void:
	if active_climb_box == null:
		return
	collision_layer = climb_box_saved_collision_layer
	collision_mask = climb_box_saved_collision_mask
	active_climb_box = null
	state = ON_FLOOR
	climb_box_top_lock_frames = 4
	floor_snap_length = 24.0
	# Слегка прижимаем тело к верхней поверхности, чтобы после анимации
	# игрок не получил состояние падения на следующем кадре.
	velocity = Vector2(0.0, 12.0)
	move_and_slide()
	velocity = Vector2.ZERO
	_play_idle_sprite()

func climb_box_to_top(box: Node2D, target_position: Vector2) -> void:
	if active_climb_box != box:
		return
	animPlayer.stop()
	anim.flip_h = climb_box_look_left
	if anim.sprite_frames.has_animation(&"climb_box_up"):
		anim.play(&"climb_box_up")
	else:
		anim.play(&"new_ledge_climbing")
	var climb_tween := get_tree().create_tween()
	climb_tween.tween_property(self, "global_position", target_position, 0.75).set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_OUT)
	await climb_tween.finished
	release_climb_box()

func descend_from_climb_box(target_y: float) -> void:
	if climb_box_drop_active:
		return
	climb_box_drop_active = true
	state = ON_CLIMB_BOX
	velocity = Vector2.ZERO
	animPlayer.stop()
	anim.stop()
	var saved_collision_layer := collision_layer
	var saved_collision_mask := collision_mask
	collision_layer = 0
	collision_mask = 0
	var drop_tween := get_tree().create_tween()
	drop_tween.tween_property(self, "global_position:y", target_y, 0.35).set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_IN)
	await drop_tween.finished
	collision_layer = saved_collision_layer
	collision_mask = saved_collision_mask
	global_position.y = target_y
	velocity = Vector2.ZERO
	state = ON_FLOOR
	climb_box_top_lock_frames = 4
	floor_snap_length = 24.0
	apply_floor_snap()
	_play_idle_sprite()
	climb_box_drop_active = false

func _update_body_render_mode() -> void:
	var use_full_body: bool = looking_up_active or wall_contact_active or run_stop_active or state in [IN_AIR, ON_WALL, ON_CLIMBING, CLIMBING_DOWN, ON_WALL_JUMP, ON_LADDER, ON_CLIMB_BOX, STRONG_FALL, DAMAGE, TURN_AROUND_LEFT, TURN_AROUND_RIGHT, ATTACK, ATTACK2, ATTACK3, MELEE_CHARGE, ON_PUSH]
	var is_crouching: bool = state == SITDOWN
	anim.visible = use_full_body
	legs_anim.visible = not use_full_body and aim_rig.visible
	aim_rig.position = crouch_visual_offset if is_crouching else Vector2.ZERO
	legs_anim.position = anim.position + (crouch_visual_offset if is_crouching else Vector2.ZERO)
	if use_full_body:
		aim_rig.visible = false

func _process(_delta: float) -> void:
	_sync_legs()

func signal_function():
	print('siganl prishel')

func _find_group_node(node: Node, group_name: StringName) -> Node2D:
	var current: Node = node
	while current != null:
		if current is Node2D and current.is_in_group(group_name):
			return current as Node2D
		current = current.get_parent()
	return null

func _grab_hanging_bar(bar: Node2D) -> void:
	if is_hanging_on_bar or ledge_grab_lock_time > 0.0 or state not in [IN_AIR, IN_WATER]:
		return
	state = ON_WALL
	velocity = Vector2.ZERO
	is_hanging_on_bar = true
	is_hanging_on_pipe = false
	is_hanging_on_fence = false
	ledge_testing = true
	ledge_pose = &""
	hanging_bar = bar
	bar_anchor_position = bar.global_position
	bar_left_limit = bar.get_left_limit() if bar.has_method("get_left_limit") else bar_anchor_position.x - 110.0
	bar_right_limit = bar.get_right_limit() if bar.has_method("get_right_limit") else bar_anchor_position.x + 110.0
	var grab_x: float = clampf(global_position.x, bar_left_limit, bar_right_limit)
	global_position = Vector2(grab_x, bar_anchor_position.y - pipe_swing_pivot.position.y)
	rotation = 0.0
	animPlayer.stop()
	if anim.sprite_frames.has_animation(&"bar_hang"):
		anim.play(&"bar_hang")
	else:
		anim.play(&"pipe_swing")
	
func update_state() -> void:
	$VBoxContainer/FSM.text = str(state_machine_info)
	
	is_on_ledge_up = raycast_up.get_collider() != null
	is_on_ledge_down = raycast_down.get_collider() != null
	raycast_hands = raycast_hands_coll.get_collider() != null
	raycast_hero_push = raycast_hero_push_coll.get_collider() != null

	# A held axe keeps its own pose until release or an interruption.
	if state == MELEE_CHARGE:
		if water_collision == true:
			_cancel_melee_charge()
			state = IN_WATER
		elif not is_on_floor():
			_cancel_melee_charge()
			state = IN_AIR
		return

	# Интерактивный ящик сам управляет перемещением игрока, пока тот держится
	# за него. Не даём обычной логике пола и уступов перехватить состояние.
	if state == ON_CLIMB_BOX:
		return
	if climb_box_top_lock_frames > 0:
		return

	# --- ПЕРЕКЛЮЧЕНИЕ РЕЖИМА ПЕРЕНОСА ---
	if Input.is_action_just_pressed("block") and state != STRONG_FALL and state != DAMAGE and state != ON_LADDER:
		if push_mode == false:
			if Global.box_player_collision == true and raycast_hero_push == true and is_on_floor():
				push_mode = true
		else:
			push_mode = false
			box_push_x = 0
			Global.push_onoff = false
			Signals.emit_signal("box_push", box_push_x)
			state = ON_FLOOR

	if push_mode == true and (Global.box_player_collision == false or raycast_hero_push == false or not is_on_floor()):
		push_mode = false
		box_push_x = 0
		Global.push_onoff = false
		Signals.emit_signal("box_push", box_push_x)
	
	damage_current = damage_basic * damage_multiplier

	# Зацеп за верхний край стены или забора. Забор определяется группой
	# Fence на StaticBody2D его коллизии.
	var ledge_down_collider: Node2D = raycast_down.get_collider() as Node2D
	var is_fence_collider: bool = ledge_down_collider != null and ledge_down_collider.is_in_group("Fence")
	raycast_pipe.force_raycast_update()
	raycast_bar.force_raycast_update()
	var bar_collider: Node2D = _find_group_node(raycast_bar.get_collider() as Node, "HangingBar")
	if bar_collider == null:
		bar_collider = _find_group_node(raycast_pipe.get_collider() as Node, "HangingBar")
	var pipe_collider: Node2D = _find_group_node(raycast_pipe.get_collider() as Node, "Pipe")
	if pipe_collider == null:
		pipe_collider = _find_group_node(ledge_down_collider, "Pipe")
	if pipe_collider == null:
		pipe_collider = _find_group_node(raycast_up.get_collider(), "Pipe")
	if (state == IN_AIR or state == IN_WATER) and ledge_grab_lock_time <= 0.0 and bar_collider != null and bar_collider.is_in_group("HangingBar"):
		state = ON_WALL
		velocity = Vector2.ZERO
		is_hanging_on_bar = true
		is_hanging_on_pipe = false
		is_hanging_on_fence = false
		ledge_testing = true
		ledge_pose = &""
		hanging_bar = bar_collider
		bar_anchor_position = bar_collider.global_position
		bar_left_limit = bar_collider.get_left_limit() if bar_collider.has_method("get_left_limit") else bar_anchor_position.x - 110.0
		bar_right_limit = bar_collider.get_right_limit() if bar_collider.has_method("get_right_limit") else bar_anchor_position.x + 110.0
		var grab_x: float = clampf(global_position.x, bar_left_limit, bar_right_limit)
		global_position = Vector2(grab_x, bar_anchor_position.y - pipe_swing_pivot.position.y)
		rotation = 0.0
		animPlayer.stop()
		if anim.sprite_frames.has_animation(&"bar_hang"):
			anim.play(&"bar_hang")
		else:
			anim.play(&"pipe_swing")
		return
	if (state == IN_AIR or state == IN_WATER) and ledge_grab_lock_time <= 0.0 and pipe_collider != null and pipe_collider.is_in_group("Pipe"):
		var incoming_horizontal_speed: float = velocity.x
		state = ON_WALL
		velocity = Vector2.ZERO
		is_hanging_on_pipe = true
		is_hanging_on_fence = false
		ledge_testing = true
		ledge_pose = &""
		# Точка захвата — неподвижная ось на трубе. Игрок висит ниже неё,
		# а не перемещается влево-вправо по прямой.
		# Ось раскачки всегда находится в центре самой трубы, а не в точке,
		# где луч случайно пересёк её поверхность.
		pipe_anchor_position = pipe_collider.global_position
		# Угол маятника направлен противоположно мировому X из-за точки
		# вращения над игроком, поэтому учитываем знак входной скорости.
		pipe_swing_angle = clampf(-incoming_horizontal_speed / 700.0, -0.35, 0.35)
		pipe_swing_velocity = -incoming_horizontal_speed / 220.0
		pipe_swing_max_angle = PIPE_MAX_ANGLE
		pipe_swing_reversal_count = 0
		pipe_last_input_direction = 0.0
		pipe_swing_input_locked = false
		pipe_swing_locked_direction = 0.0
		pipe_legs_rest_position = legs_anim.position
		pipe_aim_rig_rest_position = aim_rig.position
		global_position = pipe_anchor_position - pipe_swing_pivot.position
		rotation = 0.0
		legs_anim.rotation = 0.0
		aim_rig.rotation = 0.0
		animPlayer.stop()
		anim.play(&"pipe_swing")
		return
	if (state == IN_AIR or state == IN_WATER or (state == STRONG_FALL and not strong_fall_animation_active)) and ledge_grab_lock_time <= 0.0 and is_on_ledge_up == false and is_on_ledge_down:
		velocity.y = 0
		_snap_to_ledge_edge()
		state = ON_WALL
		# Зацеп должен сразу разрешать подъём. Иначе после прыжка на забор
		# игрок остаётся в ON_WALL, но проверка кнопки вверх не срабатывает.
		climb_on = true
		side_input_was_held_on_ledge_grab = Input.is_action_pressed("left") or Input.is_action_pressed("right")
		is_hanging_on_fence = is_fence_collider
		is_hanging_on_pipe = false
		if is_hanging_on_fence:
			fence_wall_side = 1 if raycast_up.target_position.x > 0 else -1
		ledge_right_posx = $right_ledge_grab.global_position.x
		ledge_right_posy = $right_ledge_grab.global_position.y
		ledge_left_posx = $left_ledge_grab.global_position.x
		ledge_left_posy = $left_ledge_grab.global_position.y

	elif is_on_floor() and state != IN_WATER and state != ON_LADDER and state != TURN_AROUND_LEFT and state != TURN_AROUND_RIGHT and state != CLIMBING_DOWN and state != DAMAGE and state != ATTACK2 and state != ATTACK3 and state != ATTACK and state != ON_CLIMBING and state != SITDOWN and state != STRONG_FALL:
		state = ON_FLOOR
		
	elif water_collision == true:
		if state != ON_LADDER and state != ON_WALL and state != CLIMBING_DOWN and state != ON_CLIMBING:
			state = IN_WATER

	elif !is_on_floor() and state!= IN_WATER and state != ON_LADDER and state != TURN_AROUND_LEFT and state != TURN_AROUND_RIGHT and state != CLIMBING_DOWN and state != ON_WALL_JUMP and state != ON_CLIMBING and state != ON_WALL and (state != STRONG_FALL or not strong_fall_animation_active):
		if velocity.y > 0.0:
			strong_fall_state = true
			if velocity.y > VERY_STRONG_FALL_THRESHOLD and not very_strong_fall_state:
				very_strong_fall_state = true
				# Направление кульбита берём из фактического движения, а не из взгляда.
				very_strong_fall_direction = signf(velocity.x)
			if not strong_fall_sfx_played:
				_play_fall_sfx()
				strong_fall_sfx_played = true
			state = STRONG_FALL
		else:
			state = IN_AIR
			
		if velocity.y > 50:
			if animPlayer.is_playing():
				animPlayer.stop()
			if anim.sprite_frames.has_animation(&"fall") and anim.animation != &"fall":
				anim.play(&"fall")

	if Input.is_action_just_pressed("up") and state != ON_LADDER and state != ON_CLIMBING and not is_hanging_on_pipe and ledge_testing == true and state == ON_WALL and climb_on == true and state != IN_AIR and state != STRONG_FALL:
		velocity.y = 0
		print('что за нах')
		state = ON_CLIMBING

	elif Input.is_action_pressed("up") and state in [ON_FLOOR, IN_AIR, ON_WALL_JUMP, TURN_AROUND_LEFT, TURN_AROUND_RIGHT] and Global.is_climbing == true:
		_enter_ladder_from_floor(false)

	if is_near_barrier and Input.is_action_just_pressed("attack") and state == ON_FLOOR and state != STRONG_FALL:
		break_timer += 0.5
		print(break_time, ' - ', break_timer)
	elif break_timer >= 0:
		break_timer -= 0.005
		print(break_time, ' - ', break_timer)

	if break_timer >= break_time:
		break_barrier()		

	if raycast_hands == true and state == IN_AIR:
		if animPlayer.is_playing():
			animPlayer.stop()
		if anim.animation != &"jump_hands":
			anim.play(&"jump_hands")
		elif not anim.is_playing():
			anim.play(&"jump_hands")

	# Верхняя площадка лестницы имеет приоритет над обычным спуском с выступа.
	# Проверка флага заполняется из ledge_descent_left/right, поэтому это
	# работает и когда персонаж подходит к лестнице пригнувшись.
	if Input.is_action_pressed("down") and is_ladder_top_platform and is_on_floor() and state in [ON_FLOOR, SITDOWN]:
		_begin_top_ladder_drop()

	elif Input.is_action_pressed("down") and state != IN_WATER and state != ON_LADDER and is_on_floor() and state != IN_AIR and state!= ON_WALL and state != ON_CLIMBING and state != STRONG_FALL and state != ON_PUSH:
		if (descent_ledge_left == false and descent_ledge_right == true) or (descent_ledge_left == true and descent_ledge_right == false):
			state = CLIMBING_DOWN
		elif is_on_floor() and state == ON_FLOOR:	
			state = SITDOWN

	elif Global.box_player_collision == true and raycast_hero_push and push_mode == true and is_on_floor() and state != STRONG_FALL:
		state = ON_PUSH
		print(Global.player_pushbox_left, '  ', Global.player_pushbox_right)

		if Input.is_action_pressed("right") and hero_back_coll_right == false and raycast_hero_push == true:
			if Global.player_pushbox_right == false:
				box_push_x = 0.5
				position.x += box_push_x
				Global.push_onoff = true
		elif Input.is_action_pressed("left") and hero_back_coll_left == false and raycast_hero_push == true:
			if Global.player_pushbox_left == true:
				box_push_x = -0.5
				position.x -= 0.5
				Global.push_onoff = true	
		else:
			box_push_x = 0
			Global.push_onoff = false
		Signals.emit_signal("box_push", box_push_x)

	elif state != IN_WATER and state != ATTACK2 and state != ON_LADDER and state != TURN_AROUND_LEFT and state != TURN_AROUND_RIGHT and state != CLIMBING_DOWN and state != ON_WALL_JUMP and state != ATTACK3 and state != ATTACK and state != DAMAGE and state != IN_AIR and state!= ON_WALL and state != ON_CLIMBING and collision_sitdown == false and state != STRONG_FALL and state != ON_PUSH:
		state = ON_FLOOR
		Global.push_onoff = false

	if Global.player_on_visibility_area == true and (state == SITDOWN or state == TURN_AROUND_LEFT or state == TURN_AROUND_RIGHT):
		Global.player_visibility = true
	else:
		Global.player_visibility = false

func _setup_audio() -> void:
	_breathing_player = AudioStreamPlayer.new()
	_breathing_player.name = "HeavyBreathing"
	var breathing_stream := preload("res://sound/player/heavy_breathing.wav").duplicate() as AudioStreamWAV
	breathing_stream.loop_mode = AudioStreamWAV.LOOP_FORWARD
	breathing_stream.loop_begin = 0
	breathing_stream.loop_end = int(round(breathing_stream.get_length() * breathing_stream.mix_rate))
	_breathing_player.stream = breathing_stream
	_breathing_player.volume_db = -80.0
	add_child(_breathing_player)
	_footstep_player = AudioStreamPlayer2D.new()
	_footstep_player.name = "FootstepSfx"
	add_child(_footstep_player)

	_jump_player = AudioStreamPlayer2D.new()
	_jump_player.name = "JumpSfx"
	add_child(_jump_player)

	_climb_player = AudioStreamPlayer2D.new()
	_climb_player.name = "ClimbSfx"
	add_child(_climb_player)

	_walk_streams.clear()

	if walk_sound_1 != null:
		_walk_streams.append(walk_sound_1)
	if walk_sound_2 != null:
		_walk_streams.append(walk_sound_2)
	if walk_sound_3 != null:
		_walk_streams.append(walk_sound_3)

	_jump_stream = jump_sound
	_climb_stream = climb_sound
	_fall_stream = fall_sound
	_water_stream = water_move_sound
	_dive_stream = dive_sound
	_surfacing_stream = surfacing_sound

func _update_breathing(delta: float) -> void:
	var intensity := clampf(1.0 - stamina / maxf(breathing_stamina_threshold, 0.001), 0.0, 1.0)
	if is_dead:
		intensity = 0.0
	_breathing_volume = move_toward(_breathing_volume, intensity, delta / maxf(breathing_fade_seconds, 0.001))
	_breathing_player.volume_db = linear_to_db(maxf(_breathing_volume, 0.0001)) + breathing_max_volume_db
	if _breathing_volume > 0.001:
		if not _breathing_player.playing:
			_breathing_player.play()
	elif _breathing_player.playing:
		_breathing_player.stop()

func _update_sfx_timers(delta: float) -> void:
	_walk_sfx_timer = maxf(0.0, _walk_sfx_timer - delta)
	_climb_sfx_timer = maxf(0.0, _climb_sfx_timer - delta)
	_water_sfx_timer = maxf(0.0, _water_sfx_timer - delta)

func _play_walk_step(is_running: bool) -> void:
	if _walk_streams.is_empty() or _walk_sfx_timer > 0.0:
		return

	_walk_sfx_timer = RUN_STEP_INTERVAL if is_running else WALK_STEP_INTERVAL
	_footstep_player.stream = _walk_streams[_rng.randi_range(0, _walk_streams.size() - 1)]
	_footstep_player.pitch_scale = _rng.randf_range(0.96, 1.04) * (1.08 if is_running else 1.0)
	_footstep_player.volume_db = -7.0 if is_running else -9.0
	_footstep_player.play()

func _play_jump_sfx() -> void:
	if _jump_stream == null:
		return
	_jump_player.stream = _jump_stream
	_jump_player.pitch_scale = _rng.randf_range(0.98, 1.03)
	_jump_player.volume_db = -6.0
	_jump_player.play()

func _play_climb_sfx() -> void:
	if _climb_stream == null or _climb_sfx_timer > 0.0:
		return
	_climb_sfx_timer = CLIMB_STEP_INTERVAL
	_climb_player.stream = _climb_stream
	_climb_player.pitch_scale = _rng.randf_range(0.97, 1.03)
	_climb_player.volume_db = -8.0
	_climb_player.play()

func _play_water_move_sfx() -> void:
	if _water_stream == null or _water_sfx_timer > 0.0:
		return
	_water_sfx_timer = WATER_STEP_INTERVAL
	_footstep_player.stream = _water_stream
	_footstep_player.pitch_scale = _rng.randf_range(0.95, 1.02)
	_footstep_player.volume_db = -11.0
	_footstep_player.play()

func _play_fall_sfx() -> void:
	if _fall_stream == null:
		return
	_jump_player.stream = _fall_stream
	_jump_player.pitch_scale = _rng.randf_range(0.97, 1.02)
	_jump_player.volume_db = -5.0
	_jump_player.play()

func _play_dive_sfx() -> void:
	if _dive_stream == null:
		return
	_climb_player.stream = _dive_stream
	_climb_player.pitch_scale = _rng.randf_range(0.98, 1.03)
	_climb_player.volume_db = -7.0
	_climb_player.play()

func _play_surfacing_sfx() -> void:
	if _surfacing_stream == null:
		return
	_climb_player.stream = _surfacing_stream
	_climb_player.pitch_scale = _rng.randf_range(0.98, 1.03)
	_climb_player.volume_db = -7.0
	_climb_player.play()
		
func _snap_to_ledge_edge() -> void:
	# RayCast_down попадает ровно в вертикальную грань уступа/забора.
	# Прижимаем соответствующую руку игрока к этой точке по X.
	raycast_down.force_raycast_update()
	if not raycast_down.is_colliding():
		return
	var collision_x: float = raycast_down.get_collision_point().x
	var side: int = 1 if raycast_down.target_position.x > 0.0 else -1
	# У игрока радиус коллизии около 14 px. Ставим край тела вплотную
	# к точке столкновения, без дополнительного смещения маркеров рук.
	var body_edge_offset: float = 14.0
	global_position.x = collision_x - body_edge_offset * float(side)

func _has_floor_ahead(direction: float) -> bool:
	if is_zero_approx(direction):
		return true
	var space_state := get_world_2d().direct_space_state
	var sample_x: float = global_position.x + direction * 18.0
	var from_point := Vector2(sample_x, global_position.y + 16.0)
	var to_point := Vector2(sample_x, global_position.y + 42.0)
	var query := PhysicsRayQueryParameters2D.create(from_point, to_point, raycast_down.collision_mask)
	query.exclude = [get_rid()]
	query.collide_with_bodies = true
	query.collide_with_areas = false
	var hit := space_state.intersect_ray(query)
	if hit.is_empty():
		return false
	var normal: Vector2 = hit.get("normal", Vector2.ZERO)
	return normal.y < -0.5

func _start_edge_recovery(direction: float) -> void:
	edge_recovery_active = true
	edge_recovery_elapsed = 0.0
	edge_recovery_direction = direction
	velocity.x = -direction * 100.0
	animPlayer.stop()
	if anim.sprite_frames.has_animation(&"ledge_prepare_drop_return"):
		anim.play(&"ledge_prepare_drop_return")
	else:
		_play_idle_sprite()

func _find_ledge_drop_target_y(direction: float) -> float:
	# Нижний луч должен видеть вертикальную грань. Верхний луч в момент
	# начала спуска может ещё пересекать стену, поэтому не отбрасываем
	# расчёт высоты только из-за этого промежуточного состояния.
	raycast_down.force_raycast_update()
	raycast_up.force_raycast_update()
	if not raycast_down.is_colliding():
		return NAN
	var edge_x: float = raycast_down.get_collision_point().x
	# Направление луча смотрит в вертикальную стену. Сама площадка
	# находится с обратной стороны стены: справа от левой стены и слева
	# от правой. При прежнем знаке верхняя поверхность не находилась,
	# поэтому срабатывал запасной target_y = start_y + 99.
	var platform_x: float = edge_x - direction * 4.0
	var space_state := get_world_2d().direct_space_state
	var from_point := Vector2(platform_x, global_position.y - 150.0)
	var to_point := Vector2(platform_x, global_position.y + 100.0)
	var query := PhysicsRayQueryParameters2D.create(from_point, to_point, raycast_down.collision_mask)
	query.exclude = [get_rid()]
	query.collide_with_bodies = true
	query.collide_with_areas = false
	var hit := space_state.intersect_ray(query)
	if hit.is_empty():
		return NAN
	var collider := hit.get("collider") as Node
	if collider == null or (not collider.is_in_group("Platform") and not collider.is_in_group("Fence")):
		return NAN
	var normal: Vector2 = hit.get("normal", Vector2.ZERO)
	if normal.y > -0.5:
		return NAN
	# Ставим игрока так, чтобы низ его коллайдера совпал с верхней
	# поверхностью платформы. Старое вычисление через позицию RayCast_down
	# давало лишнее вертикальное смещение и оставляло игрока ниже выступа.
	return float(hit.get("position", Vector2.ZERO).y) - PLAYER_COLLISION_BOTTOM_OFFSET

func _find_descent_edge_x(direction: float) -> Dictionary:
	# Ищем край по верхней поверхности платформы. Горизонтальный луч
	# ненадёжен, когда игрок уже частично находится над платформой:
	# его начало может оказаться внутри коллизии.
	var space_state := get_world_2d().direct_space_state
	var mask: int = raycast_down.collision_mask
	var scan_start: float = global_position.x - direction * 40.0
	var found_platform := false
	var last_platform_x: float = global_position.x
	for index in range(0, 101):
		var sample_x: float = scan_start + direction * float(index) * 2.0
		var from_point := Vector2(sample_x, global_position.y - 120.0)
		var to_point := Vector2(sample_x, global_position.y + 80.0)
		var query := PhysicsRayQueryParameters2D.create(from_point, to_point, mask)
		query.exclude = [get_rid()]
		query.collide_with_bodies = true
		query.collide_with_areas = false
		var hit := space_state.intersect_ray(query)
		var collider := hit.get("collider") as Node if not hit.is_empty() else null
		var is_platform := collider != null and collider.is_in_group("Platform")
		if is_platform:
			found_platform = true
			last_platform_x = sample_x
		elif found_platform:
			# Последний найденный сэмпл ещё над платформой, текущий уже
			# снаружи. Оставляем радиус тела вне её края.
			var edge_x: float = last_platform_x + direction * 1.0
			return {"found": true, "x": edge_x - 14.0 * signf(direction)}
	return {"found": false, "x": global_position.x}

func _physics_process(delta: float) -> void:
	last_ground_move_time = maxf(0.0, last_ground_move_time - delta)
	climb_box_top_lock_frames = maxi(climb_box_top_lock_frames - 1, 0)
	if climb_box_top_lock_frames > 0:
		velocity.y = 0.0
	if floor_jump_startup_active:
		floor_jump_startup_time = maxf(0.0, floor_jump_startup_time - delta)
		if floor_jump_startup_time <= 0.0:
			floor_jump_startup_active = false
			velocity.x = floor_jump_pending_direction * floor_jump_pending_speed
			velocity.y = -JUMP_POWER
			state = IN_AIR
			_spend_stamina(JUMP_STAMINA_COST)
			_play_jump_sfx()
			animPlayer.play("jump")
	ledge_grab_lock_time = maxf(0.0, ledge_grab_lock_time - delta)
	ladder_entry_animation_time = maxf(0.0, ladder_entry_animation_time - delta)
	ladder_top_drop_time = maxf(0.0, ladder_top_drop_time - delta)
	ladder_centering_time = maxf(0.0, ladder_centering_time - delta)
	_update_breathing(delta)
	if melee_charging and (is_dead or state != MELEE_CHARGE):
		_cancel_melee_charge()
	if melee_stage != 0 and (is_dead or state not in [ATTACK, ATTACK2, ATTACK3]):
		_clear_melee_attack()
		melee_button_down = false
	if is_dead:
		return

	update_weapon_aim()
	_update_stamina(delta)
	_update_sfx_timers(delta)
	# --- ОБРАБОТКА ТАЙМЕРОВ НЫРЯНИЯ ---
	if is_diving:
		dive_timer += delta
		# Заставляем всплывать, если достигнут лимит 5 сек
		if dive_timer >= MAX_DIVE_TIME:
			is_diving = false
			_play_surfacing_sfx()
			is_forced_surfacing = true # Включаем длинный отдых
			dive_cooldown = DIVE_COOLDOWN_TIME
			dive_timer = 0.0
	else:
		dive_timer = 0.0
		# Отсчитываем кулдаун только при вынужденном авто-всплытии
		if dive_cooldown > 0:
			dive_cooldown -= delta
			if dive_cooldown <= 0:
				is_forced_surfacing = false

	update_state()
	_update_crouch_camera(delta)
	if state == MELEE_CHARGE:
		_update_melee_charge(delta)
	# Обновляем видимость оружия ПОСЛЕ обновления состояния
	update_weapon_visibility()
	update_aim_rig()
	_update_body_render_mode()
	match state:
		IN_AIR:
			state_machine_info = "IN AIR"
			# Горизонтальная скорость задаётся один раз в момент прыжка.
			# В воздухе направление больше не перехватывается управлением.
		ON_FLOOR:
			move_character()
			jump()
			if RUN_SPEED == 2:
				state_machine_info = "RUN"
			elif velocity.x != 0:
				state_machine_info = "WALK"
			else:
				state_machine_info = "IDLE"
		BLOCK:
			block_state()
			state_machine_info = "BLOCK"
		SITDOWN:
			sitdown_state()	
			move_character()
			if velocity.x != 0:
				state_machine_info = "SITDOWN WALK"
			else:
				state_machine_info = "SITDOWN"
		SLIDE:
			state_machine_info = "Slide"
			slide_state()
		ATTACK:
			state_machine_info = "ATTACK"
			attack_state()
		ATTACK2:
			attack2_state()	
			state_machine_info = "ATTACK2"
		ATTACK3:
			attack3_state()		
			state_machine_info = "ATTACK3"	
		MELEE_CHARGE:
			velocity.x = move_toward(velocity.x, 0.0, MOVE_SPEED * 8.0 * delta)
			state_machine_info = "AXE READY" if melee_charge_elapsed >= heavy_charge_time else "AXE CHARGE"
		ON_WALL:
			state_machine_info = "WALL"
			climb()
			jump()
		ON_CLIMBING:
			climbing_up()
			state_machine_info = "CLIMBING"
		STRONG_FALL:
			strong_fall()
		DAMAGE:
			on_damage()
		ON_WALL_JUMP:
			on_walljump()
			state_machine_info = "ON WALL JUMP"
		CLIMBING_DOWN:
			climbing_down_state()
			state_machine_info = "CLIMBING DOWN"
		TURN_AROUND_LEFT:
			state_machine_info = "TURN_AROUND_LEFT"
			turn_around_left_state()
		TURN_AROUND_RIGHT:
			state_machine_info = "TURN_AROUND_RIGHT"
			turn_around_right_state()
		ON_PUSH:
			state_machine_info = "PUSH"	
			move_character()
		ON_LADDER:
			state_machine_info = "ON LADDER"	
			state_ladder()
		ON_CLIMB_BOX:
			state_machine_info = "CLIMBING BOX"
			velocity = Vector2.ZERO
		IN_WATER:
			state_machine_info = "IN WATER"	
			state_water()

	$VBoxContainer/info.text = str(velocity.x)
	if not is_on_floor() and climb_box_top_lock_frames <= 0 and state != IN_WATER and state != ON_LADDER and state != ON_WALL and state != ON_CLIMBING and state != CLIMBING_DOWN and state != ON_CLIMB_BOX and (state != STRONG_FALL or not strong_fall_animation_active):
		velocity += get_gravity() * delta

	if health <= 0:
		_enter_death_state()
		return

	move_and_slide()
	_update_wall_contact_animation_from_slide()
	if velocity.x != 0 or velocity.y != 0:
		player_pos = self.position
		Signals.emit_signal('player_position_update', player_pos)

func _update_wall_contact_animation_from_slide() -> void:
	if state != ON_FLOOR or state == ON_PUSH:
		var was_wall_contact_active: bool = wall_contact_active
		wall_contact_active = false
		wall_contact_starting = false
		if was_wall_contact_active:
			_update_body_render_mode()
		return
	var input_direction: float = Input.get_axis("left", "right")
	if is_zero_approx(input_direction):
		var was_wall_contact_active: bool = wall_contact_active
		wall_contact_active = false
		wall_contact_starting = false
		if was_wall_contact_active:
			_update_body_render_mode()
		return
	var hit_wall: bool = false
	for collision_index in get_slide_collision_count():
		var collision := get_slide_collision(collision_index)
		var collision_normal: Vector2 = collision.get_normal()
		if absf(collision_normal.x) > 0.7 and collision_normal.x * input_direction < -0.2:
			hit_wall = true
			break
	var was_wall_contact_active: bool = wall_contact_active
	wall_contact_active = hit_wall
	if wall_contact_active and not was_wall_contact_active:
		wall_contact_starting = true
	elif not wall_contact_active:
		wall_contact_starting = false
	if wall_contact_active != was_wall_contact_active:
		_update_body_render_mode()
	if not hit_wall:
		return
	_play_wall_contact_animation()

func _update_crouch_camera(delta: float) -> void:
	if not is_instance_valid(player_camera):
		return
	# При приседании zoom остаётся вокруг базового центра камеры,
	# без дополнительного смещения вниз.
	var target_y: float = player_camera_base_position.y
	if state == SITDOWN:
		target_y += CROUCH_CAMERA_DROP
	elif looking_up_active:
		target_y -= LOOK_UP_CAMERA_RAISE
	var blend: float = 1.0 - exp(-CROUCH_CAMERA_SMOOTH_SPEED * delta)
	player_camera.position.y = lerpf(player_camera.position.y, target_y, blend)
	var target_x: float = 0.0
	if is_hanging_on_pipe:
		# Камера смещается в ту же мировую сторону, куда качается игрок.
		target_x = -sin(pipe_swing_angle) * PIPE_CAMERA_OFFSET
	player_camera.position.x = lerpf(player_camera.position.x, target_x, blend)

# ПЛАВАЕМ И НЫРЯЕМ
func state_water():
	velocity.y = 0	
	
	# 1. Ручной отпуск кнопки "down" — сбрасываем ныряние сразу БЕЗ кулдауна!
	if Input.is_action_just_released("down") and is_diving:
		is_diving = false
		_play_surfacing_sfx()
		is_forced_surfacing = false
		dive_cooldown = 0.0

	# 2. Попытка нырнуть
	# Ныряем, только если зажата "down" И нет активного кулдауна от авто-всплытия
	if Input.is_action_pressed("down") and dive_cooldown <= 0:
		if not is_diving:
			is_diving = true
			_play_dive_sfx()
			# Если есть отдельная анимация начала ныряния, воспроизводим её:
			if animPlayer.has_animation("divin_start"):
				animPlayer.play("divin_start")
				

		velocity.x = 0
		if position.y < water_area3 + 20:
			position.y = move_toward(position.y, water_area3 + 20, 2)
		
		if !animPlayer.is_playing() or animPlayer.current_animation != "divin_start":
			animPlayer.play("sitdown")
	else:
		# Если не зажата кнопка ныряния — гарантируем, что не в режиме diving
		if is_diving and dive_cooldown <= 0:
			is_diving = false

		# 3. Перемещение влево / вправо в воде
		if Input.is_action_pressed("left"):
			anim.flip_h = true
			$AttackDirection.rotation_degrees = 180
			raycast_up.target_position.x = -20
			raycast_down.target_position.x = -20
			raycast_hands_coll.target_position.x = -70
			raycast_hero_push_coll.target_position.x = -20
			velocity.x = -MOVE_SPEED * WATER_SPEED_MULTIPLIER
			animPlayer.play("sitdown_walk")
			_play_water_move_sfx()
			
		elif Input.is_action_pressed("right"):
			raycast_up.target_position.x = 20
			raycast_down.target_position.x = 20
			raycast_hands_coll.target_position.x = 70
			$AttackDirection.rotation_degrees = 0
			raycast_hero_push_coll.target_position.x = 20
			anim.flip_h = false
			velocity.x = MOVE_SPEED * WATER_SPEED_MULTIPLIER
			animPlayer.play("sitdown_walk")
			_play_water_move_sfx()
			
		elif Input.is_action_pressed("up"):
			if Global.is_climbing == true:
				var tween = get_tree().create_tween()
				tween.parallel().tween_property(self, "position:x", ladder_position_x, 0.4)
				await tween.finished
				state = ON_LADDER
			if ledge_testing == true and climb_on == true and state == ON_WALL:
				state = ON_CLIMBING

		# 4. Прыжок из воды
		elif Input.is_action_just_pressed("jump"):
			is_diving = false
			is_forced_surfacing = false
			dive_cooldown = 0.0
			_play_surfacing_sfx()

			var tween = get_tree().create_tween()
			tween.parallel().tween_property(self, "position:y", global_position.y - 25, 0.15)
			await tween.finished
			
			if state != ON_WALL:
				var tween1 = get_tree().create_tween()
				tween1.tween_property(self, "position", Vector2(position.x, water_area3), 0.15)

		elif state != ON_WALL:
			velocity.x = 0
			# Воспроизведение анимации всплытия / покоя
			if is_forced_surfacing:
				# Авто-всплытие: долгая анимация усталости или восстановления
				if animPlayer.has_animation("surfacing_heavy"):
					animPlayer.play("surfacing_heavy")
				else:
					animPlayer.play("sitdown")
			else:
				# Быстрое / обычное выныривание
				if animPlayer.has_animation("surfacing_fast"):
					animPlayer.play("surfacing_fast")
				else:
					animPlayer.play("sitdown")

	# 5. Возврат на поверхность воде
	if not is_diving and position.y > water_area3 and state != ON_WALL:
		position.y = move_toward(position.y, water_area3, 3)

# ЛЕСТНИЦА И ОСТАЛЬНЫЕ МЕТОДЫ ОСТАЮТСЯ БЕЗ ИЗМЕНЕНИЙ...
func state_ladder():
	# Выход наверх выполняется одной корутиной. Не запускаем повторно
	# ladder_climbing или новую корутину, пока выходная анимация не закончилась.
	if ladder_exit_animation_active:
		velocity = Vector2.ZERO
		return
	if ladder_entry_animation_time > 0.0:
		velocity = Vector2.ZERO
		return
	if ladder_waiting_for_area:
		if Global.is_climbing:
			ladder_waiting_for_area = false
			ladder_top_drop_time = 0.0
		else:
			# Пока игрок ещё не вошёл в Area2D лестницы, направление вверх
			# игнорируется: автоматический переход должен завершиться.
			velocity = Vector2(0, 45)
			return
	if ladder_top_drop_time > 0.0:
		velocity = Vector2(0, 45)
		return
	if ladder_side_return_active:
		velocity = Vector2.ZERO
		return
	if not Input.is_action_pressed("left") and not Input.is_action_pressed("right") and ladder_side_pose != &"":
		ladder_side_pose = &""
		velocity = Vector2.ZERO
		_start_ladder_side_return()
		return
	if Input.is_action_pressed("up"):
		if Global.is_climbing == true:
			velocity.y = -30
			velocity.x = 0
			_play_ladder_climbing_sprite()
			_play_climb_sfx()
		elif Global.is_climbing == false:
			ladder_exit_animation_active = true
			var exit_position := ladder_exit_position
			if exit_position == Vector2.ZERO:
				exit_position = global_position + Vector2(20.0, -5.0)
			velocity = Vector2.ZERO
			var tween = get_tree().create_tween()
			tween.tween_property(self, "global_position", exit_position, 0.9)
			animPlayer.stop()
			animPlayer.play("new_climbung_ledge_up")
			await animPlayer.animation_finished
			await tween.finished
			ladder_exit_position = Vector2.ZERO
			hero_ladder = false
			state = ON_FLOOR
			apply_floor_snap()
			ladder_exit_animation_active = false

	elif Input.is_action_pressed("down"):
		if Global.is_climbing == true:
			if is_on_floor() and ladder_centering_time <= 0.0:
				velocity = Vector2.ZERO
				hero_ladder = false
				state = ON_FLOOR
				return
			# Даже если под ногами ещё есть платформа, мы уже на лестнице:
			# продолжаем спуск, а не выходим сразу в ON_FLOOR.
			velocity.y = +30
			velocity.x = 0
			_play_ladder_climbing_sprite()
			_play_climb_sfx()
		elif _is_near_top_ladder_exit():
			_begin_top_ladder_drop()
		else:
			# Нижний конец лестницы.
			velocity = Vector2.ZERO
			hero_ladder = false
			state = ON_FLOOR

	elif Input.is_action_pressed("right") and velocity.y == 0:
		anim.flip_h = false
		var right_blocked := _ladder_side_is_blocked(1)
		if right_blocked:
			if anim.animation != &"ladder_side_blocked" or not anim.is_playing():
				anim.play(&"ladder_side_blocked")
		else:
			if ladder_side_pose == &"":
				ladder_side_pose = &"ladder_prepare_jump"
				animPlayer.stop()
				anim.play(ladder_side_pose)
			elif ladder_side_pose == &"ladder_prepare_jump" and not anim.is_playing():
				ladder_side_pose = &"ladder_prepare_jump_idle"
				anim.play(ladder_side_pose)
			elif ladder_side_pose == &"ladder_prepare_jump_idle" and not anim.is_playing():
				anim.play(ladder_side_pose)
			if Input.is_action_just_pressed("jump"):
				ladder_side_pose = &""
				hero_ladder = false
				velocity.y = -lerp(velocity.y, 650.0, 0.6)
				velocity.x = LEDGE_SIDE_JUMP_SPEED
				anim.flip_h = false
				raycast_up.target_position.x = 20
				raycast_hero_push_coll.target_position.x = 20
				raycast_down.target_position.x = 20
				raycast_hands_coll.target_position.x = 70
				$AttackDirection.rotation_degrees = 0
				state = IN_AIR
				animPlayer.play("jump_hands")
				await animPlayer.animation_finished

	elif Input.is_action_pressed("left") and velocity.y == 0:
		anim.flip_h = true
		var left_blocked := _ladder_side_is_blocked(-1)
		if left_blocked:
			if anim.animation != &"ladder_side_blocked" or not anim.is_playing():
				anim.play(&"ladder_side_blocked")
		else:
			if ladder_side_pose == &"":
				ladder_side_pose = &"ladder_prepare_jump"
				animPlayer.stop()
				anim.play(ladder_side_pose)
			elif ladder_side_pose == &"ladder_prepare_jump" and not anim.is_playing():
				ladder_side_pose = &"ladder_prepare_jump_idle"
				anim.play(ladder_side_pose)
			elif ladder_side_pose == &"ladder_prepare_jump_idle" and not anim.is_playing():
				anim.play(ladder_side_pose)
			if Input.is_action_just_pressed("jump"):
				ladder_side_pose = &""
				hero_ladder = false
				velocity.y = -lerp(velocity.y, 650.0, 0.6)
				velocity.x = -LEDGE_SIDE_JUMP_SPEED
				anim.flip_h = true
				$AttackDirection.rotation_degrees = 180
				raycast_hero_push_coll.target_position.x = -20
				raycast_up.target_position.x = -20
				raycast_down.target_position.x = -20
				raycast_hands_coll.target_position.x = -70
				state = IN_AIR
				animPlayer.play("jump_hands")
				await animPlayer.animation_finished

	elif Input.is_action_just_pressed("block"):
		hero_ladder = false
		state = IN_AIR
	else:
		velocity.y = 0
		velocity.x = 0
		if ladder_side_pose == &"":
			_play_ladder_climbing_idle_sprite()

func _ladder_side_is_blocked(direction: int) -> bool:
	# Для прыжка с лестницы одного луча на уровне рук недостаточно:
	# препятствие может начинаться выше или ниже него. Проверяем несколько
	# уровней тела в сторону прыжка тем же collision mask, что и RayCast_hands.
	var space_state := get_world_2d().direct_space_state
	var check_heights: Array[float] = [-62.0, -42.0, -22.0, 0.0]
	var collision_mask: int = raycast_hands_coll.collision_mask
	for height: float in check_heights:
		var from_point: Vector2 = global_position + Vector2(0.0, height)
		var to_point: Vector2 = from_point + Vector2(70.0 * direction, 0.0)
		var query := PhysicsRayQueryParameters2D.create(from_point, to_point, collision_mask)
		query.exclude = [get_rid()]
		query.collide_with_areas = false
		if not space_state.intersect_ray(query).is_empty():
			return true
	return false

func strong_fall():
	if strong_fall_animation_active:
		if very_strong_fall_state:
			velocity.x = very_strong_fall_direction * VERY_STRONG_FALL_SPEED
		else:
			velocity.x = move_toward(velocity.x, 0.0, float(MOVE_SPEED) / 10.0)
		return

	if velocity.y == 0.0 and strong_fall_state:
		strong_fall_animation_active = true
		state_machine_info = "VERY STRONG FALL" if very_strong_fall_state else "STRONG FALL"
		if animPlayer.is_playing():
			animPlayer.stop()
		var landing_animation: StringName = &"very_sTRONG_FALL" if very_strong_fall_state and anim.sprite_frames.has_animation(&"very_sTRONG_FALL") else &"strong_fall"
		if anim.sprite_frames.has_animation(landing_animation):
			anim.play(landing_animation)
		if very_strong_fall_state:
			velocity.x = very_strong_fall_direction * VERY_STRONG_FALL_SPEED
		else:
			velocity.x = move_toward(velocity.x, 0.0, float(MOVE_SPEED) / 10.0)
		await anim.animation_finished
		strong_fall_animation_active = false
		strong_fall_state = false
		very_strong_fall_state = false
		very_strong_fall_direction = 0.0
		strong_fall_sfx_played = false
		velocity.x = 0.0
		state = ON_FLOOR

	elif strong_fall_state == false:
		strong_fall_sfx_played = false
		very_strong_fall_state = false
		very_strong_fall_direction = 0.0
		state = IN_AIR

func _enter_ladder_from_floor(from_top: bool = false) -> void:
	if not Global.is_climbing:
		return
	velocity = Vector2.ZERO
	state = ON_LADDER
	ladder_centering_time = 0.2
	var tween := get_tree().create_tween()
	tween.tween_property(self, "global_position:x", ladder_position_x, 0.2)
	# Переходная анимация используется и при входе с платформы,
	# и при входе сверху. Пока она идёт, управление лестницей не меняет позу.
	_play_ladder_transition_animation(&"ladder_enter_platform", 0.7)

func _play_ladder_transition_animation(animation_name: StringName, fallback_time: float, block_movement: bool = true) -> void:
	animPlayer.stop()
	if anim.sprite_frames.has_animation(animation_name):
		anim.play(animation_name)
		var fps: float = anim.sprite_frames.get_animation_speed(animation_name)
		var frame_count: int = anim.sprite_frames.get_frame_count(animation_name)
		if block_movement:
			ladder_entry_animation_time = maxf(0.15, float(frame_count) / maxf(fps, 1.0))
	else:
		if block_movement:
			ladder_entry_animation_time = fallback_time
		animPlayer.play("ladder_climbing_ilde")

func _begin_top_ladder_drop() -> void:
	if not is_instance_valid(active_ladder_area):
		return
	var ladder_root := active_ladder_area.get_parent()
	if not ladder_root.has_method("begin_top_drop") or not ladder_root.is_top_exit():
		return
	ladder_root.begin_top_drop()
	velocity = Vector2(0, 45)
	ladder_top_drop_time = 0.35
	ladder_waiting_for_area = true
	state = ON_LADDER
	var tween := get_tree().create_tween()
	tween.parallel().tween_property(self, "global_position:x", ladder_position_x, 0.2)
	_play_ladder_transition_animation(&"ladder_drop_from_top", 0.7, false)

func _is_near_top_ladder_exit() -> bool:
	if not is_at_ladder_top or not is_instance_valid(active_ladder_area):
		return false
	var ladder_root := active_ladder_area.get_parent()
	if not ladder_root.has_method("begin_top_drop") or not ladder_root.is_top_exit() or not ladder_root.has_method("get_exit_position"):
		return false
	return global_position.distance_to(ladder_root.get_exit_position()) <= 48.0

func climbing_down_state():
	if ledge_descent_active:
		return
	if not ((descent_ledge_left == false and descent_ledge_right == true) or (descent_ledge_right == false and descent_ledge_left == true)):
		return
	ledge_descent_active = true
	climb_on = false
	if descent_ledge_left == false and descent_ledge_right == true:
		velocity.x = 0
		anim.flip_h = false
		animPlayer.stop()
		anim.play(&"ledge_grab_down")
		raycast_up.target_position.x = 20
		raycast_hero_push_coll.target_position.x = 20
		raycast_down.target_position.x = 20
		raycast_hands_coll.target_position.x = 70
		var tween = get_tree().create_tween()
		var descent_x: float = global_position.x
		var descent_y: float = global_position.y
		if descent_ledge_center == true:
			tween.tween_property(self, "global_position:x", descent_x - 16.0, 0.4)
		tween.tween_property(self, "global_position:y", descent_y + 85.0, 0.6)
		await tween.finished
		ledge_right_posx = $right_ledge_grab.global_position.x
		ledge_right_posy = $right_ledge_grab.global_position.y
		ledge_left_posx = $left_ledge_grab.global_position.x
		ledge_left_posy = $left_ledge_grab.global_position.y
		state = ON_WALL
		velocity = Vector2.ZERO
		anim.stop()
		ledge_pose = &""
		ledge_testing = true
		climb_on = true
		is_on_ledge_down = false
		ledge_descent_active = false

	elif descent_ledge_right == false and descent_ledge_left == true:
		velocity.x = 0
		anim.flip_h = true
		animPlayer.stop()
		anim.play(&"ledge_grab_down")
		raycast_up.target_position.x = -20
		raycast_down.target_position.x = -20
		raycast_hands_coll.target_position.x = -70
		raycast_hero_push_coll.target_position.x = -20
		var tween = get_tree().create_tween()
		var descent_x: float = global_position.x
		var descent_y: float = global_position.y
		if descent_ledge_center == true:
			tween.tween_property(self, "global_position:x", descent_x + 16.0, 0.4)
		tween.tween_property(self, "global_position:y", descent_y + 85.0, 0.6)
		await tween.finished
		ledge_right_posx = $right_ledge_grab.global_position.x
		ledge_right_posy = $right_ledge_grab.global_position.y
		ledge_left_posx = $left_ledge_grab.global_position.x
		ledge_left_posy = $left_ledge_grab.global_position.y
		state = ON_WALL
		velocity = Vector2.ZERO
		anim.stop()
		ledge_pose = &""
		ledge_testing = true
		climb_on = true
		is_on_ledge_down = false
		ledge_descent_active = false

func _start_turn_animation() -> void:
	animPlayer.stop()
	anim.animation = turn_animation_name
	var turn_speed_scale: float = 1.8
	if turn_animation_name == &"turn_around_walk":
		turn_speed_scale = 2.2
	elif turn_animation_name == &"turn_around_run":
		turn_speed_scale = 2.6
	anim.speed_scale = turn_speed_scale
	anim.play(turn_animation_name, 1.0, false)
	anim.frame = 0
	anim.frame_progress = 0.0
	turn_animation_active = true
	if turn_animation_name == &"turn_around_walk":
		turn_animation_time_left = 0.13
	elif turn_animation_name == &"turn_around_run":
		turn_animation_time_left = 0.10
	else:
		turn_animation_time_left = 0.15

func turn_around_left_state():
	if not turn_animation_active:
		_start_turn_animation()
		return
	turn_animation_time_left -= get_physics_process_delta_time()
	if turn_animation_time_left > 0.0:
		return
	turn_animation_active = false
	turn_around_left = false
	turn_around_right = true
	state = ON_FLOOR

func turn_around_right_state():
	if not turn_animation_active:
		_start_turn_animation()
		return
	turn_animation_time_left -= get_physics_process_delta_time()
	if turn_animation_time_left > 0.0:
		return
	turn_animation_active = false
	turn_around_left = true
	turn_around_right = false
	state = ON_FLOOR

func move_character() -> void:
	if climbing_lock: # пока не завершился подъём с выступа, движение и повороты не обрабатываем
		velocity.x = 0
		return
	if floor_jump_startup_active:
		velocity.x = 0
		return
	if edge_recovery_active:
		edge_recovery_elapsed += get_physics_process_delta_time()
		velocity.x = -edge_recovery_direction * 100.0 if edge_recovery_elapsed < 0.16 else 0.0
		if edge_recovery_elapsed >= 0.22:
			edge_recovery_active = false
			edge_recovery_elapsed = 0.0
			edge_recovery_direction = 0.0
			if state == SITDOWN:
				animPlayer.play("sitdown")
			else:
				_play_idle_sprite()
		return

	if state == ON_FLOOR:
		MOVE_SPEED = 120
		$Head.disabled = false
		
	var direction = Input.get_axis('left', 'right')
	# После стартового падения первое направление сразу становится текущим
	# направлением движения, без проигрывания разворота.
	if state == ON_FLOOR and not startup_direction_initialized and not is_zero_approx(direction):
		startup_direction_initialized = true
		dir_look = direction > 0.0
		anim.flip_h = not dir_look
		turn_around_left = dir_look
		turn_around_right = not dir_look
	var near_ledge_edge: bool = (descent_ledge_left == false and descent_ledge_right == true) or (descent_ledge_left == true and descent_ledge_right == false)
	if direction != 0.0 and state == SITDOWN and RUN_SPEED != 2 and not Input.is_action_pressed("down") and is_on_floor() and (not _has_floor_ahead(direction) or near_ledge_edge):
		if absf(velocity.x) <= 90.0 and not edge_recovery_used:
			edge_recovery_used = true
			_start_edge_recovery(signf(direction))
			return
	elif direction != 0.0 and is_on_floor() and _has_floor_ahead(direction):
		# Игрок отошёл от текущего края — следующий край снова может
		# активировать защиту один раз.
		edge_recovery_used = false

	if direction:
		# Новое направление отменяет только текущую остановку после бега.
		# Остальные состояния и анимации движения не затрагиваются.
		var cancelled_run_stop: bool = run_stop_active
		run_stop_active = false
		if cancelled_run_stop:
			_update_body_render_mode()
		looking_up_active = false
		if state == ON_FLOOR:
			last_ground_move_direction = signf(direction)
			last_ground_move_time = JUMP_DIRECTION_BUFFER_TIME
		var acceleration: float = RUN_ACCELERATION if RUN_SPEED == 2 else WALK_ACCELERATION
		velocity.x = lerp(velocity.x, direction * MOVE_SPEED * RUN_SPEED, acceleration)
		if velocity.y == 0:
			if state == SITDOWN:
				if is_on_wall() and raycast_hands_coll:
					animPlayer.play("sitdown")
				else:
					animPlayer.play("sitdown_walk")
			elif (wall_contact_active or is_on_wall()) and state != ON_PUSH:
				_play_wall_contact_animation()
			else:
				if state == ON_PUSH:
					var box_direction: float = signf(float(box_push_x))
					if not is_zero_approx(box_direction):
						# Игрок движется в ту же сторону, что и ящик — толкает;
						# в противоположную — тянет. Используем текущий input,
						# а не dir_look, который обновляется позже в этом кадре.
						var movement_animation: StringName = &"push" if is_equal_approx(box_direction, signf(direction)) else &"pull"
						play_box_animation(movement_animation)
					else:
						play_box_animation(&"idle")
				else:
					# Ходьба и бег проигрываются напрямую через AnimatedSprite2D.
					# AnimationPlayer не должен перезаписывать кадры SpriteFrames.
					if animPlayer.is_playing():
						animPlayer.stop()
					var locomotion_animation: StringName = &"walking" if RUN_SPEED == 1 else &"run"
					if anim.animation != locomotion_animation:
						anim.play(locomotion_animation)
				if state == ON_FLOOR:
					_play_walk_step(Input.is_action_pressed("run"))
	else:
		var speed_before_braking: float = absf(velocity.x)
		velocity.x = move_toward(velocity.x, 0, float(MOVE_SPEED) / 5)
		if state == ON_FLOOR and not run_stop_active and speed_before_braking >= RUN_STOP_MIN_SPEED and anim.sprite_frames.has_animation(&"run_stop"):
			run_stop_active = true
			animPlayer.stop()
			anim.play(&"run_stop")
			_update_body_render_mode()

		if run_stop_active and anim.animation == &"run_stop":
			# Не даём обычному idle перебить всю анимацию резкой остановки.
			looking_up_active = false
		elif run_stop_active:
			run_stop_active = false
			_update_body_render_mode()
			if velocity.y == 0 and state == ON_FLOOR:
				looking_up_active = false
				_play_idle_sprite()
		elif velocity.y == 0 and state == ON_FLOOR:
			var should_look_up: bool = Input.is_action_pressed("up") and not Global.is_climbing and absf(velocity.x) <= 2.0
			if should_look_up:
				if not looking_up_active:
					looking_up_active = true
					animPlayer.stop()
					anim.play(&"look_up")
			else:
				looking_up_active = false
				_play_idle_sprite()
		elif state == SITDOWN:	
			animPlayer.play("sitdown")
		elif state == ON_PUSH and (Global.player_pushbox_left == true or Global.player_pushbox_right == true):
			play_box_animation(&"idle")

	if state == ON_FLOOR or state == SITDOWN:
		if dir_look == true: 
			anim.flip_h = false
			if state != SITDOWN and turn_around_left == true and direction < 0.0:
				if absf(velocity.x) > 5.0:
					turn_animation_name = &"turn_around_run" if RUN_SPEED == 2 else &"turn_around_walk"
				else:
					turn_animation_name = &"turn_around"
				state = TURN_AROUND_LEFT
			if collision_sitdown:
				$Head.disabled = true
				state = SITDOWN
			raycast_up.target_position.x = 20
			raycast_down.target_position.x = 20
			raycast_hands_coll.target_position.x = 70
			$AttackDirection.rotation_degrees = 0
			raycast_hero_push_coll.target_position.x = 20
		elif dir_look == false: 
			anim.flip_h = true
			if state != SITDOWN and turn_around_right == true and direction > 0.0:
				if absf(velocity.x) > 5.0:
					turn_animation_name = &"turn_around_run" if RUN_SPEED == 2 else &"turn_around_walk"
				else:
					turn_animation_name = &"turn_around"
				state = TURN_AROUND_RIGHT
			if collision_sitdown:
				$Head.disabled = true
				state = SITDOWN
			$AttackDirection.rotation_degrees = 180
			raycast_up.target_position.x = -20
			raycast_down.target_position.x = -20
			raycast_hands_coll.target_position.x = -70
			raycast_hero_push_coll.target_position.x = -20

	if direction > 0:
		dir_look = true
		if state == SITDOWN:
			turn_around_left = false
			turn_around_right = true
	elif direction < 0:
		dir_look = false
		if state == SITDOWN:
			turn_around_left = true
			turn_around_right = false

	if Input.is_action_pressed("run") and state == ON_FLOOR and _can_sprint():
		RUN_SPEED = 2
		if velocity.x != 0 or velocity.y != 0:
			Signals.emit_signal('player_run_speed_update', RUN_SPEED)
	elif state == ON_PUSH:
		RUN_SPEED = 0.2
	else:
		RUN_SPEED = 1
		if velocity.x != 0 or velocity.y != 0:
			Signals.emit_signal('player_run_speed_update', RUN_SPEED)

func on_walljump():
	await get_tree().create_timer(0.4).timeout
	state = IN_AIR

func jump() -> void:
	if climbing_lock: # прыжок тоже блокируем на время подъёма
		return
	if floor_jump_startup_active:
		return
	if Input.is_action_just_pressed("jump") and state != ON_CLIMBING:
		if state == ON_FLOOR:
			var jump_input_direction: float = Input.get_axis("left", "right")
			var jump_direction: float = signf(jump_input_direction)
			if is_zero_approx(jump_direction) and last_ground_move_time > 0.0:
				jump_direction = last_ground_move_direction
			if is_zero_approx(jump_direction) and absf(velocity.x) > 2.0:
				# Учитываем короткое нажатие направления прямо перед прыжком.
				jump_direction = signf(velocity.x)
			var jump_forward_speed: float = JUMP_TAP_SPEED
			if absf(velocity.x) >= JUMP_TAP_VELOCITY_LIMIT:
				jump_forward_speed = JUMP_LOW_SPEED
			if absf(velocity.x) >= JUMP_LOW_VELOCITY_LIMIT:
				jump_forward_speed = JUMP_RUN_SPEED if RUN_SPEED == 2 or Input.is_action_pressed("run") else JUMP_WALK_SPEED
			floor_jump_pending_direction = jump_direction
			floor_jump_pending_speed = jump_forward_speed
			floor_jump_startup_active = true
			floor_jump_startup_time = FLOOR_JUMP_STARTUP_TIME
			velocity.x = 0.0
			return

		if state == ON_WALL:
			if is_hanging_on_bar:
				if Input.is_action_pressed("down"):
					is_hanging_on_bar = false
					hanging_bar = null
					ledge_testing = false
					ledge_grab_lock_time = 0.22
					velocity = Vector2(0.0, 140.0)
					rotation = 0.0
					state = IN_AIR
					anim.play("fall")
					return
				var bar_direction := Input.get_axis("left", "right")
				if absf(bar_direction) > 0.0 and ((bar_direction < 0.0 and global_position.x <= bar_left_limit + BAR_EDGE_TOLERANCE) or (bar_direction > 0.0 and global_position.x >= bar_right_limit - BAR_EDGE_TOLERANCE)):
					is_hanging_on_bar = false
					hanging_bar = null
					ledge_testing = false
					ledge_grab_lock_time = 0.22
					velocity = Vector2(bar_direction * BAR_SIDE_JUMP_SPEED, -JUMP_POWER * 0.8)
					rotation = 0.0
					state = IN_AIR
					anim.play("jump_hands")
					return
				return
			if is_hanging_on_pipe:
				if Input.is_action_pressed("down"):
					# Down + jump means a straight drop from the pipe, not a
					# swing launch. Clear the pivot state before entering the air.
					var pipe_swing_force: float = absf(pipe_swing_velocity) * 45.0 + absf(sin(pipe_swing_angle)) * 120.0
					var pipe_drop_impulse: float = 0.0
					if pipe_swing_force > 4.0:
						var pipe_swing_direction: float = -signf(pipe_swing_angle)
						if is_zero_approx(pipe_swing_direction):
							pipe_swing_direction = -signf(pipe_swing_velocity)
						var pipe_drop_strength: float = clampf(pipe_swing_force * 0.6, 20.0, 85.0)
						pipe_drop_impulse = pipe_swing_direction * pipe_drop_strength
					is_hanging_on_pipe = false
					ledge_testing = false
					pipe_swing_angle = 0.0
					pipe_swing_velocity = 0.0
					pipe_swing_input_locked = false
					pipe_swing_locked_direction = 0.0
					velocity = Vector2(pipe_drop_impulse, 140.0)
					ledge_grab_lock_time = 0.22
					rotation = 0.0
					legs_anim.position = pipe_legs_rest_position
					legs_anim.rotation = 0.0
					aim_rig.position = pipe_aim_rig_rest_position
					aim_rig.rotation = 0.0
					state = IN_AIR
					return
				var pipe_launch_power: float = clampf(absf(pipe_swing_velocity) * 0.55 + absf(pipe_swing_angle) * 0.8, 0.0, 1.0)
				# Направление прыжка совпадает с движением маятника. Чем больше
				# угол и скорость раскачки, тем сильнее горизонтальный импульс.
				velocity.x = clampf(-pipe_swing_velocity * 45.0 - sin(pipe_swing_angle) * 120.0, -170.0, 170.0)
				velocity.y = -JUMP_POWER * (0.72 + pipe_launch_power * 0.28)
				is_hanging_on_pipe = false
				ledge_testing = false
				ledge_grab_lock_time = 0.22
				rotation = 0.0
				legs_anim.position = pipe_legs_rest_position
				legs_anim.rotation = 0.0
				aim_rig.position = pipe_aim_rig_rest_position
				aim_rig.rotation = 0.0
				animPlayer.play("jump_hands")
				state = IN_AIR
				return
			# Вниз теперь только готовит спуск. Отцепление происходит по прыжку.
			if Input.is_action_pressed("down"):
				var was_hanging_on_fence := is_hanging_on_fence
				velocity = Vector2.ZERO
				velocity.y = 140.0
				ledge_grab_lock_time = 0.22
				is_on_ledge_down = false
				ledge_testing = false
				ledge_pose = &""
				is_hanging_on_fence = false
				if was_hanging_on_fence:
					animPlayer.stop()
					anim.play(&"fence_drop")
				else:
					animPlayer.play("descent_ledge")
				state = IN_AIR
				return

			if Input.is_action_pressed("right") and Input.is_action_just_pressed("jump") and raycast_up.target_position.x == -20:
				var was_hanging_on_fence := is_hanging_on_fence
				velocity.y = -lerp(velocity.y, 650.0, 0.6)
				velocity.x = LEDGE_SIDE_JUMP_SPEED
				anim.flip_h = false
				raycast_up.target_position.x = 20
				raycast_hero_push_coll.target_position.x = 20
				raycast_down.target_position.x = 20
				raycast_hands_coll.target_position.x = 70
				$AttackDirection.rotation_degrees = 0
				state = IN_AIR
				is_hanging_on_fence = false
				ledge_grab_lock_time = 0.22
				if was_hanging_on_fence:
					animPlayer.stop()
					anim.play(&"fence_jump")
				else:
					animPlayer.play("jump_hands")

			if Input.is_action_pressed("left") and Input.is_action_just_pressed("jump") and raycast_up.target_position.x == 20:
				var was_hanging_on_fence := is_hanging_on_fence
				velocity.y = -lerp(velocity.y, 650.0, 0.6)		
				velocity.x = -LEDGE_SIDE_JUMP_SPEED
				anim.flip_h = true
				$AttackDirection.rotation_degrees = 180
				raycast_hero_push_coll.target_position.x = -20
				raycast_up.target_position.x = -20
				raycast_down.target_position.x = -20
				raycast_hands_coll.target_position.x = -70
				state = IN_AIR
				is_hanging_on_fence = false
				ledge_grab_lock_time = 0.22
				if was_hanging_on_fence:
					animPlayer.stop()
					anim.play(&"fence_jump")
				else:
					animPlayer.play("jump_hands")

func block_state():
	velocity.x = move_toward(velocity.x, 0, float(MOVE_SPEED) / 20)
	animPlayer.play('block')

func slide_state():
	velocity.x = move_toward(velocity.x, 0, float(MOVE_SPEED) / 40)
	animPlayer.play("slide")
	await animPlayer.animation_finished
	velocity.x = move_toward(velocity.x, float(MOVE_SPEED), MOVE_SPEED * 2)
	state = ON_FLOOR

func attack_state():
	_melee_state(1)

func attack2_state():
	_melee_state(2)

func attack3_state():
	_melee_state(3)

func _face_melee_toward(mouse_position: Vector2) -> void:
	var mouse_offset := mouse_position.x - global_position.x
	if not is_zero_approx(mouse_offset):
		aim_facing_right = mouse_offset > 0.0
	anim.flip_h = not aim_facing_right
	dir_look = aim_facing_right
	turn_around_left = not aim_facing_right
	turn_around_right = aim_facing_right
	$AttackDirection.rotation_degrees = 0.0 if aim_facing_right else 180.0

func _press_melee() -> void:
	if melee_button_down or is_dead:
		return
	if state in [ATTACK, ATTACK2] and not melee_is_heavy:
		# Быстрое повторное нажатие сразу ставит следующий удар в очередь.
		melee_queued = true
		return
	if state != ON_FLOOR or attack_cooldown or push_mode or not _melee_has_stamina(melee_stamina_cost):
		return
	# Charge takes over the floor state before update_state can count this tap.
	if is_near_barrier:
		break_timer += 0.5
		if break_timer >= break_time:
			break_barrier()
	melee_button_down = true
	_begin_melee_charge()

func _begin_melee_charge() -> void:
	_clear_melee_attack()
	melee_charging = true
	melee_charge_elapsed = 0.0
	state = MELEE_CHARGE
	Global.player_visibility = false
	weapon.force_stop_shooting()
	_face_melee_toward(get_global_mouse_position())
	anim.stop()
	if animPlayer.has_animation(&"axe_charge"):
		var charge_animation: Animation = animPlayer.get_animation(&"axe_charge")
		if charge_animation != null and charge_animation.length > 0.0:
			animPlayer.play(&"axe_charge", -1.0, charge_animation.length / heavy_charge_time)
		else:
			animPlayer.play(&"axe_charge")
	else:
		# Защита от повреждённой сцены: отсутствие анимации не ломает игру.
		animPlayer.stop()
	update_weapon_visibility()
	_update_body_render_mode()

func _update_melee_charge(delta: float) -> void:
	if not melee_charging:
		return
	_face_melee_toward(get_global_mouse_position())
	melee_charge_elapsed += delta
	if melee_charge_elapsed >= heavy_charge_time:
		# Удержание автоматически выполняет мощный третий удар.
		melee_charging = false
		melee_charge_elapsed = 0.0
		melee_button_down = false
		_start_melee(3, true)
		return
	if melee_charge_elapsed >= melee_hold_threshold and not _melee_has_stamina(heavy_stamina_cost):
		_cancel_melee_charge()

func _release_melee() -> void:
	if not melee_button_down:
		return
	melee_button_down = false
	if melee_charging and state == MELEE_CHARGE:
		var use_heavy := melee_charge_elapsed >= heavy_charge_time
		if melee_charge_elapsed >= melee_hold_threshold and not _melee_has_stamina(heavy_stamina_cost):
			_cancel_melee_charge()
			return
		melee_charging = false
		melee_charge_elapsed = 0.0
		_start_melee(3 if use_heavy else 1, use_heavy)
	elif state in [ATTACK, ATTACK2] and not melee_is_heavy:
		melee_queued = true

func _cancel_melee_charge() -> void:
	melee_charging = false
	melee_charge_elapsed = 0.0
	melee_button_down = false
	melee_queued = false
	melee_hitbox.set_deferred("disabled", true)
	if animPlayer.current_animation == &"axe_charge":
		# Damage can arrive inside a physics signal; do not reset collision tracks.
		animPlayer.stop(true)
	if state == MELEE_CHARGE:
		state = ON_FLOOR
		_play_idle_sprite()
	update_weapon_visibility()
	_update_body_render_mode()

func _clear_melee_attack() -> void:
	melee_stage = 0
	melee_queued = false
	melee_is_heavy = false
	melee_pending_stamina_cost = 0.0
	melee_stamina_paid = false
	melee_hit_active = false
	combo = false
	melee_hitbox.set_deferred("shape", melee_normal_shape)
	melee_hitbox.set_deferred("position", melee_hitbox_position)
	if animPlayer.current_animation in [&"attack", &"attack2", &"attack3", &"attack4", &"axe_heavy"]:
		# Stop immediately without reapplying the animation's disabled track.
		animPlayer.stop(true)

func _melee_state(stage: int) -> void:
	velocity.x = move_toward(velocity.x, 0, float(MOVE_SPEED) / 20)
	if melee_stage != stage:
		_start_melee(stage)

func _start_melee(stage: int, heavy: bool = false) -> void:
	var stamina_cost := heavy_stamina_cost if heavy else melee_stamina_cost
	if not _melee_has_stamina(stamina_cost):
		_clear_melee_attack()
		state = ON_FLOOR
		return
	state = [ATTACK, ATTACK2, ATTACK3][stage - 1]
	melee_stage = stage
	melee_queued = false
	melee_is_heavy = heavy
	melee_pending_stamina_cost = stamina_cost
	melee_stamina_paid = false
	melee_hit_active = false
	combo = false
	melee_targets.clear()
	# Use the same deferred order as cleanup, including press/release in one frame.
	melee_hitbox.set_deferred("shape", melee_heavy_shape if heavy else melee_normal_shape)
	melee_hitbox.set_deferred("position", melee_hitbox_position + (Vector2(heavy_reach_bonus, 0.0) if heavy else Vector2.ZERO))
	damage_multiplier = heavy_damage_multiplier if heavy else [1.0, 1.2, 2.0][stage - 1]
	damage_current = damage_basic * damage_multiplier
	_face_melee_toward(get_global_mouse_position())
	weapon.force_stop_shooting()
	if not anim.sprite_frames.has_animation(anim.animation):
		anim.animation = &"idle"
	anim.stop()
	var attack_animation: StringName = [&"attack", &"attack2", &"attack3"][stage - 1]
	if heavy:
		attack_animation = &"attack4" if animPlayer.has_animation(&"attack4") else &"attack3"
	if not animPlayer.has_animation(attack_animation):
		attack_animation = &"attack3" if heavy else &"attack"
	var lunge_speed: float = heavy_melee_lunge_speed if heavy else melee_lunge_speed
	velocity.x = (1.0 if aim_facing_right else -1.0) * lunge_speed
	animPlayer.play(attack_animation)
	update_weapon_visibility()
	_update_body_render_mode()

func _on_melee_hit_window_opened() -> void:
	# Списываем энергию только когда анимация действительно открыла хитбокс.
	if state in [ATTACK, ATTACK2, ATTACK3] and melee_stage != 0 and not melee_stamina_paid:
		if not _commit_melee_stamina():
			return
	if state in [ATTACK, ATTACK2, ATTACK3] and melee_stage != 0 and _melee_wall_ahead():
		_start_melee_wall_impact()

func _melee_wall_ahead() -> bool:
	# Луч направлен в сторону замаха и обновляется сразу в момент удара.
	raycast_hands_coll.target_position.x = 70.0 if aim_facing_right else -70.0
	raycast_hands_coll.force_raycast_update()
	return raycast_hands_coll.get_collider() != null

func _start_melee_wall_impact() -> void:
	if melee_wall_recovery_active:
		return
	melee_wall_recovery_active = true
	melee_queued = false
	melee_button_down = false
	combo = false
	melee_hit_active = false
	velocity.x = (-1.0 if aim_facing_right else 1.0) * melee_wall_recoil_speed
	animPlayer.stop(true)
	if anim.sprite_frames.has_animation(&"attack_wall"):
		anim.stop()
		anim.play(&"attack_wall", 1.0, false)
	await get_tree().create_timer(melee_wall_recovery_time).timeout
	if state in [ATTACK, ATTACK2, ATTACK3]:
		_clear_melee_attack()
		state = ON_FLOOR
		attack_freeze()
	melee_wall_recovery_active = false

func _commit_melee_stamina() -> bool:
	# The animation opens its hit window here, even when the swing misses.
	# An interrupted windup clears the pending cost before this can run.
	if is_dead or melee_stage == 0 or state not in [ATTACK, ATTACK2, ATTACK3]:
		return false
	if melee_stamina_paid:
		return true
	if not _melee_has_stamina(melee_pending_stamina_cost):
		_clear_melee_attack()
		state = ON_FLOOR
		return false
	melee_stamina_paid = true
	if not test_unlimited_melee_stamina:
		_spend_stamina(melee_pending_stamina_cost)
	return true

func _on_melee_animation_finished(animation_name: StringName) -> void:
	if animation_name not in [&"attack", &"attack2", &"attack3", &"attack4", &"axe_heavy"]:
		return
	if state not in [ATTACK, ATTACK2, ATTACK3] or melee_stage == 0:
		return
	if melee_stage < 3 and melee_button_down and not melee_is_heavy:
		_begin_melee_charge()
	elif melee_stage < 3 and melee_queued and combo:
		state = ATTACK2 if melee_stage == 1 else ATTACK3
		_start_melee(melee_stage + 1)
	else:
		_clear_melee_attack()
		state = ON_FLOOR
		attack_freeze()

func combo1():
	combo = true

func attack_freeze():
	attack_cooldown = true
	await get_tree().create_timer(0.5).timeout
	attack_cooldown = false

func sitdown_state():
	MOVE_SPEED = 40
	$Head.disabled = true

func _on_sitdown_area_body_entered(body: Node2D) -> void:
	if body.is_in_group("Platform"):
		collision_sitdown = true

func _on_sitdown_area_body_exited(_body: Node2D) -> void:
	collision_sitdown = false

func _update_pipe_swing(delta: float) -> void:
	# Раскачка работает удержанием. Кнопка в сторону движения добавляет силу,
	# а противоположная кнопка сразу разворачивает маятник.
	# Из-за направления вращения вокруг верхнего маркера знак угла обратный:
	# положительный ввод вправо должен давать положительное смещение по X.
	var horizontal_input: float = -Input.get_axis("left", "right")
	if not is_zero_approx(horizontal_input):
		var input_direction: float = signf(horizontal_input)
		if not is_zero_approx(pipe_last_input_direction) and input_direction != pipe_last_input_direction:
			pipe_swing_reversal_count += 1
			if pipe_swing_reversal_count >= 4:
				pipe_swing_max_angle = PIPE_PROGRESSIVE_THIRD_ANGLE
			elif pipe_swing_reversal_count >= 2:
				pipe_swing_max_angle = PIPE_PROGRESSIVE_SECOND_ANGLE
		pipe_last_input_direction = input_direction
	if is_zero_approx(horizontal_input):
		pipe_swing_input_locked = false
		pipe_swing_locked_direction = 0.0
	elif pipe_swing_input_locked and signf(horizontal_input) == pipe_swing_locked_direction:
		# Старое удержание игнорируем до отпускания кнопки: маятник сам
		# возвращается в нижнюю центральную позицию.
		pass
	else:
		var reached_same_side: bool = absf(pipe_swing_angle) >= pipe_swing_max_angle - 0.02 and signf(pipe_swing_angle) == signf(horizontal_input)
		if reached_same_side:
			# На краю сразу разворачиваем маятник к центру. Даже если
			# кнопка всё ещё удерживается, игрок не зависает на пределе.
			pipe_swing_velocity = -signf(pipe_swing_angle) * PIPE_EDGE_RETURN_VELOCITY
			pipe_swing_input_locked = true
			pipe_swing_locked_direction = signf(horizontal_input)
		else:
			var speed_scale: float = 1.0
			if pipe_swing_reversal_count < 2:
				speed_scale = PIPE_FIRST_SPEED_SCALE
			elif pipe_swing_reversal_count < 4:
				speed_scale = PIPE_SECOND_SPEED_SCALE
			pipe_swing_velocity += horizontal_input * PIPE_SWING_HOLD_ACCELERATION * speed_scale * delta
	pipe_swing_velocity = move_toward(pipe_swing_velocity, 0.0, PIPE_SWING_DAMPING * delta)
	pipe_swing_velocity -= pipe_swing_angle * PIPE_SWING_RESTORE * delta
	pipe_swing_velocity = clampf(pipe_swing_velocity, -2.8, 2.8)
	# При подъёме маятника скорость постепенно падает. На обратном ходе
	# ограничение не применяется, поэтому пружина разгоняет игрока к центру.
	var angle_ratio: float = clampf(absf(pipe_swing_angle) / pipe_swing_max_angle, 0.0, 1.0)
	var is_moving_outward: bool = absf(pipe_swing_angle) > 0.01 and signf(pipe_swing_velocity) == signf(pipe_swing_angle)
	if is_moving_outward:
		var outward_speed_limit: float = lerpf(2.8, PIPE_OUTWARD_SPEED_AT_EDGE, angle_ratio * angle_ratio)
		pipe_swing_velocity = clampf(pipe_swing_velocity, -outward_speed_limit, outward_speed_limit)
	pipe_swing_angle = clampf(pipe_swing_angle + pipe_swing_velocity * delta, -pipe_swing_max_angle, pipe_swing_max_angle)
	# Направление берём из фактического движения по мировой оси X. Оно
	# противоположно знаку угла маятника из-за расположения оси над игроком.
	var swing_world_direction: float = -pipe_swing_velocity
	# В центре трубы скорость несколько кадров может менять знак из-за
	# пружины. Не переворачиваем игрока от этого микроколебания.
	if absf(swing_world_direction) < 0.20:
		swing_world_direction = -pipe_swing_angle
	if absf(swing_world_direction) >= 0.20:
		_set_pipe_facing(1 if swing_world_direction > 0.0 else -1)
	# Маятник вращается вокруг точки, где руки держатся за трубу.
	# Поворачиваем игрока вокруг Marker2D, а не вокруг его центральной точки.
	# Маркер остаётся на трубе, как ось качелей.
	global_position = pipe_anchor_position - pipe_swing_pivot.position.rotated(pipe_swing_angle)
	# Настоящий поворот Player вокруг верхнего маркера. Маркер остаётся
	# неподвижным, поэтому персонаж вращается как маятник на качелях.
	rotation = pipe_swing_angle
	legs_anim.position = pipe_legs_rest_position
	legs_anim.rotation = 0.0
	aim_rig.position = pipe_aim_rig_rest_position
	aim_rig.rotation = 0.0

func _set_pipe_facing(direction: int) -> void:
	var facing_right: bool = direction > 0
	anim.flip_h = not facing_right
	dir_look = facing_right
	turn_around_left = not facing_right
	turn_around_right = facing_right
	$AttackDirection.rotation_degrees = 0.0 if facing_right else 180.0
	raycast_up.target_position.x = 20.0 if facing_right else -20.0
	raycast_down.target_position.x = 20.0 if facing_right else -20.0
	raycast_hands_coll.target_position.x = 70.0 if facing_right else -70.0
	raycast_hero_push_coll.target_position.x = 20.0 if facing_right else -20.0

func _start_ledge_return_animation(return_animation: StringName) -> void:
	if ledge_return_animation_active:
		return
	ledge_return_animation_active = true
	animPlayer.stop()
	anim.play(return_animation)
	await anim.animation_finished
	if state == ON_WALL and ledge_pose == &"":
		anim.play(&"fence_grab" if is_hanging_on_fence else &"ledge_grab")
	ledge_return_animation_active = false

func climb():
	if ledge_return_animation_active and not is_hanging_on_pipe:
		velocity = Vector2.ZERO
		climb_on = true
		return
	if is_hanging_on_pipe:
		_update_pipe_swing(get_physics_process_delta_time())
		velocity = Vector2.ZERO
		if animPlayer.is_playing():
			animPlayer.stop()
		if anim.animation != &"pipe_swing":
			anim.play(&"pipe_swing")
		climb_on = true
		return
	if is_hanging_on_bar:
		velocity = Vector2.ZERO
		climb_on = true
		var bar_direction := Input.get_axis("left", "right")
		if absf(bar_direction) > 0.0:
			global_position.x = clampf(global_position.x + bar_direction * BAR_HAND_MOVE_SPEED * get_physics_process_delta_time(), bar_left_limit, bar_right_limit)
			var at_left_edge: bool = global_position.x <= bar_left_limit + BAR_EDGE_TOLERANCE
			var at_right_edge: bool = global_position.x >= bar_right_limit - BAR_EDGE_TOLERANCE
			if bar_direction < 0.0 and at_left_edge:
				anim.flip_h = true
				anim.play(&"bar_prepare_jump_left")
			elif bar_direction > 0.0 and at_right_edge:
				anim.flip_h = false
				anim.play(&"bar_prepare_jump_right")
			elif bar_direction < 0.0:
				anim.flip_h = true
				anim.play(&"bar_move")
			else:
				anim.flip_h = false
				anim.play(&"bar_move")
		elif anim.animation != &"bar_hang":
			anim.play(&"bar_hang")
		return

	if is_hanging_on_fence:
		velocity = Vector2.ZERO
		ledge_testing = true
		anim.flip_h = fence_wall_side < 0
		if (fence_wall_side > 0 and Input.is_action_just_pressed("right")) or (fence_wall_side < 0 and Input.is_action_just_pressed("left")):
			_start_fence_vault()
			return
		var fence_pose: StringName = &""
		var side_pressed := Input.is_action_pressed("left") or Input.is_action_pressed("right")
		# Если одна поза уже была выбрана, второе одновременно зажатое
		# направление не должно её перебивать.
		if ledge_pose != &"" and side_pressed and Input.is_action_pressed("down"):
			fence_pose = ledge_pose
		elif side_pressed and not side_input_was_held_on_ledge_grab:
			fence_pose = &"wall_hands_forward"
		elif Input.is_action_pressed("down") and not side_pressed:
			fence_pose = &"ledge_prepare_drop"
		if fence_pose != &"":
			if ledge_pose != fence_pose:
				ledge_pose = fence_pose
				animPlayer.stop()
				anim.play(ledge_pose)
			elif ledge_pose == &"ledge_prepare_drop" and not anim.is_playing():
				anim.play(&"ledge_prepare_drop_idle")
			elif ledge_pose == &"wall_hands_forward" and not anim.is_playing():
				anim.play(&"wall_hands_forward_idle")
		elif ledge_pose != &"":
			var return_animation: StringName = &"ledge_prepare_drop_return"
			if ledge_pose == &"wall_hands_forward":
				return_animation = &"wall_hands_forward_return"
			ledge_pose = &""
			animPlayer.stop()
			_start_ledge_return_animation(return_animation)
		elif anim.animation != &"fence_grab":
			anim.play(&"fence_grab")
		climb_on = true
		if not Input.is_action_pressed("left") and not Input.is_action_pressed("right"):
			side_input_was_held_on_ledge_grab = false
		return

	if Input.is_action_pressed("up"):
		state = ON_CLIMBING
		climbing_up()
		if climbing_lock: # climbing_up() реально запустил подъём - не затираем его анимацию "висением"
			return
	
	velocity.x = 0
	ledge_testing = true
	if raycast_up.target_position.x == -20:
		anim.flip_h = true
	elif raycast_up.target_position.x == 20:
		anim.flip_h = false

	# На уступе боковая стрелка готовит прыжок в сторону стены наружу.
	# Вниз готовит отдельную позу с взглядом вниз, но не меняет состояние игрока.
	var wanted_pose: StringName = &""
	var side_pressed := Input.is_action_pressed("left") or Input.is_action_pressed("right")
	# Первая выбранная поза сохраняется, пока зажаты обе кнопки:
	# добавление второго направления не меняет анимацию и направление.
	if ledge_pose != &"" and side_pressed and Input.is_action_pressed("down"):
		wanted_pose = ledge_pose
	elif side_pressed and not side_input_was_held_on_ledge_grab and ((raycast_up.target_position.x == -20 and Input.is_action_pressed("right")) or (raycast_up.target_position.x == 20 and Input.is_action_pressed("left"))):
		wanted_pose = &"wall_hands_forward"
	elif Input.is_action_pressed("down") and not side_pressed:
		wanted_pose = &"ledge_prepare_drop"

	if wanted_pose != &"":
		if ledge_pose != wanted_pose:
			ledge_pose = wanted_pose
			animPlayer.stop()
			anim.play(ledge_pose)
		elif ledge_pose == &"ledge_prepare_drop" and not anim.is_playing():
			anim.play(&"ledge_prepare_drop_idle")
		elif ledge_pose == &"wall_hands_forward" and not anim.is_playing():
			anim.play(&"wall_hands_forward_idle")
	else:
		if ledge_pose != &"":
			var return_animation: StringName = &"ledge_prepare_drop_return"
			if ledge_pose == &"wall_hands_forward":
				return_animation = &"wall_hands_forward_return"
			ledge_pose = &""
			_start_ledge_return_animation(return_animation)
		elif animPlayer.current_animation != &"climbing":
			animPlayer.play("climbing")
	climb_on = true
	if not Input.is_action_pressed("left") and not Input.is_action_pressed("right"):
		side_input_was_held_on_ledge_grab = false

func climbing_up():
	if climbing_lock: # уже поднимаемся - игнорируем повторные вызовы, пока корутина не завершилась
		return
	if is_hanging_on_fence:
		if Input.is_action_just_pressed("up") or (fence_wall_side > 0 and Input.is_action_just_pressed("right")) or (fence_wall_side < 0 and Input.is_action_just_pressed("left")):
			_start_fence_vault()
		return

	climb_on = false
	_play_climb_sfx()
		
	if raycast_up.target_position.x == 20 and Input.is_action_just_pressed("up"):
		climbing_lock = true
		state = ON_CLIMBING 
		velocity = Vector2.ZERO
		_play_climb_sfx()
		animPlayer.stop()
		anim.stop()
		anim.play(&"new_ledge_climbing")
		var right_frame_count: int = anim.sprite_frames.get_frame_count(&"new_ledge_climbing")
		var right_fps: float = anim.sprite_frames.get_animation_speed(&"new_ledge_climbing")
		var right_climb_duration: float = maxf(LEDGE_CLIMB_MOVE_MIN_DURATION, float(right_frame_count) / maxf(right_fps * LEDGE_CLIMB_MOVE_SPEED_SCALE, 1.0))
		var right_finish_tween := get_tree().create_tween()
		right_finish_tween.tween_property(self, "global_position:y", ledge_right_posy + LEDGE_CLIMB_FINAL_Y_OFFSET, right_climb_duration * 0.6)
		right_finish_tween.tween_property(self, "global_position:x", ledge_right_posx, right_climb_duration * 0.34)
		await right_finish_tween.finished
		anim.stop()
		state = ON_FLOOR
		anim.flip_h = false
		turn_around_left = false
		turn_around_right = true
	elif raycast_up.target_position.x == -20 and Input.is_action_pressed("up"):
		climbing_lock = true
		state = ON_CLIMBING
		_play_climb_sfx()
		animPlayer.stop()
		anim.stop()
		anim.play(&"new_ledge_climbing")
		var left_frame_count: int = anim.sprite_frames.get_frame_count(&"new_ledge_climbing")
		var left_fps: float = anim.sprite_frames.get_animation_speed(&"new_ledge_climbing")
		var left_climb_duration: float = maxf(LEDGE_CLIMB_MOVE_MIN_DURATION, float(left_frame_count) / maxf(left_fps * LEDGE_CLIMB_MOVE_SPEED_SCALE, 1.0))
		var left_finish_tween := get_tree().create_tween()
		left_finish_tween.tween_property(self, "global_position:y", ledge_left_posy + LEDGE_CLIMB_FINAL_Y_OFFSET, left_climb_duration * 0.6)
		left_finish_tween.tween_property(self, "global_position:x", ledge_left_posx, left_climb_duration * 0.34)
		await left_finish_tween.finished
		anim.stop()
		state = ON_FLOOR
		anim.flip_h = true
		turn_around_left = true
		turn_around_right = false
	else:
		return # ни одно условие не сработало - блокировку выставлять не за что

	is_on_ledge_down = false
	is_on_ledge_up = false # чтобы зацеп за стену не сработал заново на краю выступа
	wall_contact_active = false
	velocity = Vector2.ZERO
	climbing_lock = false # ввод разблокирован - подъём полностью завершён
	_update_body_render_mode()
	# state оставляем ON_FLOOR (выставлен в ветках выше) - НЕ откатываем в IN_AIR,
	# иначе update_state() снова поймает рейкаст выступа и утащит игрока в ON_WALL

func _on_barrier_area_body_entered(body: Node2D) -> void:
	if body.name == "Player":
		is_near_barrier = true

func _on_barrier_area_body_exited(_body: Node2D) -> void:
	is_near_barrier = false

func _start_fence_vault() -> void:
	if fence_vault_active or not is_hanging_on_fence:
		return
	fence_vault_active = true
	climbing_lock = true
	state = ON_CLIMBING
	velocity = Vector2.ZERO
	animPlayer.stop()
	anim.play(&"fence_vault")

	# A vault is a controlled traversal, not ordinary horizontal movement.  If
	# the body keeps colliding with the fence while it crosses it, CharacterBody2D
	# resolves the penetration by sliding the player sideways through the fence.
	# Temporarily removing the player from the physics layers also prevents the
	# dog's Area2D attack from hitting during the invulnerable traversal window.
	fence_vault_saved_collision_layer = collision_layer
	fence_vault_saved_collision_mask = collision_mask
	collision_layer = 0
	collision_mask = 0

	var start_position := global_position
	var vault_direction := float(fence_wall_side)
	# После предыдущего перелезания игрок находится дальше обычной длины
	# луча, поэтому временно увеличиваем его, чтобы найти тот же забор при
	# перелезании обратно.
	raycast_down.target_position.x = vault_direction * (FENCE_VAULT_DISTANCE + FENCE_THICKNESS + 10.0)
	raycast_down.force_raycast_update()
	var fence_top_y := _find_fence_top_y(start_position.y)
	var apex_y := fence_top_y - PLAYER_COLLISION_BOTTOM_OFFSET - FENCE_VAULT_TOP_CLEARANCE
	var target_position := Vector2(
		start_position.x + vault_direction * FENCE_VAULT_DISTANCE,
		start_position.y
	)
	# Keep the path sane if a malformed/partial fence has no detectable top.
	apex_y = minf(apex_y, start_position.y - 8.0)

	fence_vault_tween = get_tree().create_tween()
	fence_vault_tween.set_parallel(false)
	fence_vault_tween.tween_property(self, "global_position:y", apex_y, FENCE_VAULT_UP_DURATION).set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_OUT)
	fence_vault_tween.tween_property(self, "global_position:x", target_position.x, FENCE_VAULT_CROSS_DURATION).set_trans(Tween.TRANS_LINEAR)
	fence_vault_tween.tween_property(self, "global_position:y", target_position.y, FENCE_VAULT_DOWN_DURATION).set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_IN)
	await fence_vault_tween.finished
	fence_vault_tween = null
	global_position = target_position

	# The player is now fully on the opposite side; restore normal physics only
	# after the whole body has cleared the fence.
	collision_layer = fence_vault_saved_collision_layer
	collision_mask = fence_vault_saved_collision_mask
	fence_wall_side *= -1
	raycast_up.target_position.x = 20.0 * fence_wall_side
	raycast_down.target_position.x = 20.0 * fence_wall_side
	raycast_hands_coll.target_position.x = 70.0 * fence_wall_side
	raycast_hero_push_coll.target_position.x = 20.0 * fence_wall_side
	anim.flip_h = fence_wall_side < 0
	state = ON_WALL
	climbing_lock = false
	fence_vault_active = false

func _find_fence_top_y(fallback_y: float) -> float:
	# Cast through the fence at the hand-side X.  The first hit from above is
	# the top surface, so the calculation remains valid for fences of different
	# heights instead of depending on a level-specific magic Y coordinate.
	raycast_down.force_raycast_update()
	if not raycast_down.is_colliding():
		return fallback_y - PLAYER_COLLISION_BOTTOM_OFFSET - 8.0
	var fence_edge_x: float = raycast_down.get_collision_point().x
	var space_state := get_world_2d().direct_space_state
	# Проверяем несколько точек около внутренней стороны. Это устраняет
	# зависимость от направления, когда луч проходит ровно по краю коллизии.
	for offset in [4.0, 2.0, 0.0, -2.0, -4.0]:
		var sample_x: float = fence_edge_x + float(fence_wall_side) * offset
		var query := PhysicsRayQueryParameters2D.create(
			Vector2(sample_x, fallback_y - 220.0),
			Vector2(sample_x, fallback_y + 40.0),
			raycast_down.collision_mask
		)
		query.exclude = [get_rid()]
		query.collide_with_bodies = true
		query.collide_with_areas = false
		var hit := space_state.intersect_ray(query)
		var collider: Node = hit.get("collider") as Node if not hit.is_empty() else null
		if collider != null and collider.is_in_group("Fence"):
			return float(hit.get("position", Vector2(fallback_y, fallback_y)).y)
	return fallback_y - PLAYER_COLLISION_BOTTOM_OFFSET - 8.0

func break_barrier():
	if is_instance_valid(barrier_area):
		barrier_area.visible = false
	break_timer = 0.0
	is_near_barrier = false

func _on_damage_received(enemy_damage):
	if melee_charging:
		_cancel_melee_charge()
	melee_button_down = false
	_clear_melee_attack()
	var was_on_pipe: bool = is_hanging_on_pipe
	var was_on_ledge := was_on_pipe or state == ON_WALL or state == ON_CLIMBING or state == CLIMBING_DOWN
	if state == BLOCK:
		enemy_damage /= 2
	else:
		state = DAMAGE
	health -= enemy_damage
	emit_signal('health_changed', health)
	if was_on_ledge:
		drop_from_ledge_after_damage = true
		climb_on = false
		climbing_lock = false
		ledge_testing = false
		is_on_ledge_up = false
		is_on_ledge_down = false
		velocity.y = maxf(velocity.y, 140.0)
		velocity.x = 0
		if was_on_pipe:
			# Damage must break the pipe hold immediately. Otherwise the swing
			# angle and pipe constraint remain active while the player is hurt.
			is_hanging_on_pipe = false
			pipe_swing_angle = 0.0
			pipe_swing_velocity = 0.0
			pipe_swing_input_locked = false
			pipe_swing_locked_direction = 0.0
			rotation = 0.0
			legs_anim.rotation = 0.0
			aim_rig.rotation = 0.0
			legs_anim.position = pipe_legs_rest_position
			aim_rig.position = pipe_aim_rig_rest_position
			ledge_grab_lock_time = maxf(ledge_grab_lock_time, 0.25)
	state = DAMAGE

func on_damage():
	velocity.x = 0
	animPlayer.play("damage")
	await animPlayer.animation_finished
	if drop_from_ledge_after_damage:
		drop_from_ledge_after_damage = false
		state = IN_AIR
	else:
		state = ON_FLOOR

func _on_hit_box_area_entered(area: Area2D) -> void:
	_melee_hit(area)

func _on_melee_body_entered(body: Node2D) -> void:
	_melee_hit(body)

func _melee_hit(candidate: Node) -> void:
	if state not in [ATTACK, ATTACK2, ATTACK3] or melee_stage == 0:
		return
	if $AttackDirection/DamageBox/HitBox/CollisionShape2D.disabled:
		return
	var target := candidate
	while target != null and target != self:
		if target.has_method("take_damage") or target.has_method("_on_damage_received"):
			break
		target = target.get_parent()
	if target == null or target == self or melee_targets.has(target.get_instance_id()):
		return
	melee_targets[target.get_instance_id()] = true
	var direction := Vector2.RIGHT
	if target is Node2D:
		direction = global_position.direction_to(target.global_position)
	var hit_damage := int(round(damage_basic * damage_multiplier))
	if target.has_method("interrupt_pounce"):
		# Interrupt the dog's jump attack synchronously. Damage itself remains
		# deferred to preserve the existing hit processing order.
		target.call("interrupt_pounce", direction)
	if target.has_method("take_damage"):
		target.call_deferred("take_damage", hit_damage, direction)
	else:
		target.call_deferred("_on_damage_received", hit_damage)

func _enter_death_state() -> void:
	if is_dead:
		return
	is_dead = true
	if melee_charging:
		_cancel_melee_charge()
	melee_button_down = false
	_clear_melee_attack()
	velocity = Vector2.ZERO
	weapon.force_stop_shooting()
	weapon.visible = false
	animPlayer.stop()
	anim.visible = true
	legs_anim.visible = false
	aim_rig.visible = false
	anim.play(&"death")
	await anim.animation_finished
	await get_tree().create_timer(2.0).timeout
	_create_death_screen()


func _create_death_screen() -> void:
	var death_layer := CanvasLayer.new()
	death_layer.name = "DeathScreen"
	death_layer.layer = 100
	death_layer.process_mode = Node.PROCESS_MODE_ALWAYS
	get_tree().current_scene.add_child(death_layer)

	var backdrop := ColorRect.new()
	backdrop.color = Color(0.015, 0.02, 0.025, 0.82)
	backdrop.mouse_filter = Control.MOUSE_FILTER_IGNORE
	backdrop.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	death_layer.add_child(backdrop)

	var center := CenterContainer.new()
	center.mouse_filter = Control.MOUSE_FILTER_IGNORE
	center.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	death_layer.add_child(center)

	var message := Label.new()
	message.text = "МЁРТ\nНажмите любую клавишу"
	message.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	message.add_theme_font_size_override("font_size", 34)
	message.add_theme_color_override("font_color", Color(0.9, 0.82, 0.68, 1.0))
	message.add_theme_color_override("font_outline_color", Color(0.05, 0.03, 0.02, 1.0))
	message.add_theme_constant_override("outline_size", 8)
	center.add_child(message)


func _restart_after_death() -> void:
	if death_restart_requested:
		return
	death_restart_requested = true
	get_tree().reload_current_scene()

func _on_ledge_descent_right_body_entered(body: Node2D) -> void:
	_register_ladder_top_platform(body)
	if body.is_in_group("Platform"):
		descent_ledge_right = true

func _on_ledge_descent_right_body_exited(body: Node2D) -> void:
	_unregister_ladder_top_platform(body)
	if body.is_in_group("Platform"):
		descent_ledge_right = false

func _on_ledge_descent_left_body_entered(body: Node2D) -> void:
	_register_ladder_top_platform(body)
	if body.is_in_group("Platform"):
		descent_ledge_left = true

func _on_ledge_descent_left_body_exited(body: Node2D) -> void:
	_unregister_ladder_top_platform(body)
	if body.is_in_group("Platform"):
		descent_ledge_left = false

func _register_ladder_top_platform(body: Node2D) -> void:
	if not body.is_in_group("LadderTopPlatform"):
		return
	ladder_top_platform_contacts += 1
	is_ladder_top_platform = true
	# TopPlatform находится внутри ExitTop у корня лестницы. Сохраняем
	# ссылку на Area2D лестницы, чтобы последующий drop сразу вошёл в неё.
	var exit_marker := body.get_parent() as Node2D
	var ladder_root := exit_marker.get_parent() as Node2D if exit_marker != null else null
	if ladder_root == null:
		return
	var ladder_area := ladder_root.get_node_or_null("Area2D") as Area2D
	if ladder_area != null:
		active_ladder_area = ladder_area
		ladder_position_x = ladder_area.global_position.x
		ladder_exit_position = _get_ladder_exit_position(ladder_area)
		is_at_ladder_top = true

func _unregister_ladder_top_platform(body: Node2D) -> void:
	if not body.is_in_group("LadderTopPlatform"):
		return
	ladder_top_platform_contacts = maxi(ladder_top_platform_contacts - 1, 0)
	is_ladder_top_platform = ladder_top_platform_contacts > 0

func _on_ledge_descent_center_body_exited(_body: Node2D) -> void:
	descent_ledge_center = false

func _on_ledge_descent_center_body_entered(_body: Node2D) -> void:
	descent_ledge_center = true

func _on_hero_back_area_body_entered(body: Node2D) -> void:
	if body.name == "Static_body_items":
		hero_back_coll_left = true
			
func _on_hero_back_area_body_exited(body: Node2D) -> void:
	if body.name == "Static_body_items":
		hero_back_coll_left = false
		
func _on_hero_back_area_left_right_body_entered(body: Node2D) -> void:
	if body.name == "Static_body_items":
		hero_back_coll_right = true

func _on_hero_back_area_left_right_body_exited(body: Node2D) -> void:
	if body.name == "Static_body_items":
		hero_back_coll_right = false

func _on_collision_area_area_entered(area: Area2D) -> void:
	if area.is_in_group("Ladder"):
		# При падении после прыжка состояние уже может быть STRONG_FALL,
		# но игрок всё ещё находится в воздухе и должен поймать лестницу.
		var was_airborne := state in [IN_AIR, ON_WALL_JUMP] or (state == STRONG_FALL and not strong_fall_animation_active)
		ladder_position_x = area.global_position.x 
		active_ladder_area = area
		ladder_exit_position = _get_ladder_exit_position(area)
		ladder_waiting_for_area = false
		ladder_top_drop_time = 0.0
		Global.is_climbing = true
		if was_airborne:
			_grab_ladder_from_air()
	if area.is_in_group("LadderTop"):
		is_at_ladder_top = true
		active_ladder_area = area
		ladder_position_x = area.global_position.x
		ladder_exit_position = _get_ladder_exit_position(area)
	if area.is_in_group("Water"):
		water_collision = true
		water_area1 = area.get_child(0).shape.get_rect().size.y / 2
		water_area2 = area.get_child(0).position.y + 30
		water_area3 = (water_area2 - water_area1)
		if !is_on_floor() and state != CLIMBING_DOWN and state != ON_WALL: 
			var tween = get_tree().create_tween()
			tween.tween_property(self, "position", Vector2(global_position.x, water_area3), 0.2)
			await tween.finished

func _on_collision_area_area_exited(area: Area2D) -> void:
	if area.is_in_group("Ladder"):
		Global.is_climbing = false
		# Не очищаем active_ladder_area: на верхнем выходе игрок уже
		# покидает Area2D, но ещё должен закончить анимацию выхода.
	if area.is_in_group("LadderTop"):
		is_at_ladder_top = false
	if area.is_in_group("Water"):
		water_collision = false
		state = IN_AIR

func _grab_ladder_from_air() -> void:
	# Автозахват как в Replaced: пересечение лестницы в прыжке
	# немедленно переводит игрока в состояние удержания.
	velocity = Vector2.ZERO
	state = ON_LADDER
	ladder_centering_time = 0.2
	var tween := get_tree().create_tween()
	tween.tween_property(self, "global_position:x", ladder_position_x, 0.12)
	_play_ladder_transition_animation(&"ladder_grab_air", 0.3)

func _get_ladder_exit_position(area: Area2D) -> Vector2:
	var ladder_root := area.get_parent()
	if ladder_root != null and ladder_root.has_method("get_exit_position"):
		return ladder_root.get_exit_position()

	# Поддержка старых лестниц, которые сделаны простой Area2D.
	var direction := String(area.get_meta("exit_direction", "top"))
	var offset := Vector2(20.0, -5.0)
	if area.has_meta("exit_offset"):
		offset = area.get_meta("exit_offset")
	else:
		match direction:
			"left":
				offset = Vector2(-25.0, -5.0)
			"right":
				offset = Vector2(27.0, -5.0)
	return area.global_position + offset



func update_weapon_aim() -> void:
	# WeaponPivot находится под ArmsPivot и наследует его вращение от плеча.
	weapon_pivot.rotation = 0.0


func update_aim_rig() -> void:
	# Старый покадровый aiming больше не используется.
	if not weapon.visible:
		aim_rig.visible = false
		return

	aim_rig.visible = true

	var direction := get_global_mouse_position() - global_position
	if direction.length_squared() < 0.001:
		return

	# Спрайты зеркалятся по горизонтали, поэтому вертикальный угол одинаков
	# для обеих сторон. Иначе при цели слева руки начинали смотреть вверх.
	# Near the player's center, keep the previous side so vertical mouse
	# movement cannot make the whole aiming rig flip back and forth.
	if absf(direction.x) > AIM_SIDE_DEADZONE:
		aim_facing_right = direction.x > 0.0
	var facing_right := aim_facing_right
	aim_arms_pivot.position = Vector2(
		aim_arms_pivot_default_position.x + (aim_arms_right_offset_x if facing_right else 0.0),
		aim_arms_pivot_default_position.y
	)
	aim_arms_sprite.flip_h = facing_right
	aim_arms_sprite.flip_v = false
	aim_head_sprite.flip_h = facing_right
	aim_body_sprite.flip_h = facing_right
	aim_arms_sprite.position.x = -aim_arms_default_position.x if facing_right else aim_arms_default_position.x
	aim_head_sprite.position.x = -aim_head_default_position.x if facing_right else aim_head_default_position.x
	weapon_pivot.position = Vector2(
		weapon_pivot_default_position.x if facing_right else -weapon_pivot_default_position.x,
		weapon_pivot_default_position.y
	)
	# Aim from the weapon pivot, not from the player's center. The weapon is
	# offset above the player, so using global_position made shots pass above
	# the cursor.
	var weapon_direction := get_global_mouse_position() - weapon_pivot.global_position
	if weapon_direction.length_squared() > 0.001:
		# Arms follow the same pivot-based angle as the weapon.
		var aim_angle := atan2(weapon_direction.y, absf(weapon_direction.x))
		# The left-facing hand sprite has the opposite vertical orientation.
		aim_arms_pivot.rotation = aim_angle if facing_right else -aim_angle
		var head_angle := aim_angle if facing_right else -aim_angle
		aim_head_pivot.rotation = clampf(head_angle, -0.65, 0.65)
		weapon_pivot.global_rotation = weapon_direction.angle()
	weapon.set_aim_facing(facing_right)

func can_player_shoot() -> bool:
	if state == MELEE_CHARGE:
		return false

	if state == ON_LADDER:
		return false

	if state == ON_CLIMBING:
		return false

	if state == CLIMBING_DOWN:
		return false

	if state == IN_WATER:
		return false

	if state == ON_WALL:
		return false

	if state == ON_PUSH or state == ON_CLIMB_BOX:
		return false

	if state == DAMAGE:
		return false

	if state == STRONG_FALL:
		return false

	# Запрещаем стрельбу во время всех ударов мечом
	if state == ATTACK:
		return false

	if state == ATTACK2:
		return false

	if state == ATTACK3:
		return false

	return true
	
func _input(event):
	if is_dead:
		if (event is InputEventKey or event is InputEventMouseButton) and event.pressed:
			_restart_after_death()
		return

	if event.is_action_pressed("attack"):
		_press_melee()
	elif event.is_action_released("attack"):
		_release_melee()

	if event.is_action_pressed("shoot"):

		if can_player_shoot() and weapon.can_shoot and weapon.ammo_in_magazine > 0:
			weapon.shoot()
			if camera_shaker.has_method("apply_shot_shake"):
				camera_shaker.apply_shot_shake()

	if event.is_action_pressed("reload") and state not in [MELEE_CHARGE, ATTACK, ATTACK2, ATTACK3]:
		weapon.reload()

func _notification(what: int) -> void:
	if what == NOTIFICATION_APPLICATION_FOCUS_OUT and is_node_ready():
		melee_button_down = false
		melee_queued = false
		if melee_charging:
			_cancel_melee_charge()

func update_weapon_visibility():
	var can_show_weapon = true
	
	# Состояния, где оружие должно быть скрыто
	match state:
		ON_WALL, ON_CLIMBING, CLIMBING_DOWN, ON_LADDER, ON_CLIMB_BOX, IN_WATER, STRONG_FALL, DAMAGE, ON_PUSH, MELEE_CHARGE, ATTACK, ATTACK2, ATTACK3:
			can_show_weapon = false
		# Убираем SITDOWN из списка - оружие должно быть видно
	
	# Если оружие должно быть скрыто - принудительно останавливаем стрельбу
	if not can_show_weapon:
		weapon.force_stop_shooting()
		weapon.visible = false
	else:
		weapon.visible = true
