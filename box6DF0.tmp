[sub_resource type="GDScript" id="GDScript_6vv1w"]
script/source = "extends Node2D

var gold = preload(\"res://Collectbels/gold.tscn\")

var rng = RandomNumberGenerator.new()

func _on_timer_timeout() -> void:
	var goldTemp = gold.instantiate()
	var randint = randi_range(50,1500)
	add_child(goldTemp)
	goldTemp.position = Vector2(randint,550)
"

